    Position = "left"
})

-- Toggle principal
HitboxConfigSection:AddToggle({
    Name = "Ativar Hitbox Expansiva",
    Default = false,
    Flag = "Combat_HitboxEnabled",
    Callback = function(state)
        toggleHitboxes(state)   -- sua função já existente
    end
})

