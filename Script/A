SecMain:AddToggle({ Name = "Self ESP", Callback = function(v) Config.SelfESP = v end });
SecMain:AddToggle({ Name = "Team Check", Callback = function(v) Config.TeamCheck = v end });
SecMain:AddSlider({ Name = "Distância Máxima", Min = 100, Max = 10000, Default = 1000, Callback = function(v) Config.MaxDistance = v end });
SecMain:AddToggle({ Name = "Escalonamento Dinâmico", Default = true, Callback = function(v) Config.DynamicScaling = v end });

-- Seção Box
local SecBox = Tab:DrawSection({ Name = "Box ESP", Position = 'right' });
SecBox:AddToggle({ Name = "Ativar Box", Callback = function(v) Config.Box.Enabled = v end }).Link:AddColorPicker({ Default = Config.Box.Color, Callback = function(v) Config.Box.Color = v end });
SecBox:AddDropdown({ Name = "Tipo de Box", Default = "Full", Values = {"Full", "Corner"}, Callback = function(v) Config.Box.Type = v end });
SecBox:AddSlider({ Name = "Espessura", Min = 1, Max = 10, Default = 1, Callback = function(v) Config.Box.Thickness = v end });
