-- Speed

local MovementSection = MovementTab:DrawSection({
    Name = "- Speed",
    Position = "left"
})
MovementSection:AddParagraph({
    Title = "< • > - Config Speed",
    Content = "Ajuste a velocidade do personagem."
})
local SpeedToggleState = false
local SpeedMode = "WalkSpeed"
local SpeedValue = 16
local SpeedLoopConnection = nil
local TextboxSpeedAPI = nil
local SliderSpeedAPI = nil
-- Guarda contra recursão slider<->textbox: SetValue dispara o Callback, que por
-- sua vez chama SetValue do par. Sem isso o LoadConfig/SaveConfig entra em
-- recursão infinita (stack overflow).
local SpeedSyncing = false
local function GetHumanoid()
    local Char = Player.Character
    if not Char then return nil end
    return Char:FindFirstChildOfClass("Humanoid")
end
local function ApplySpeed()
    local Hum = GetHumanoid()
    if not Hum then return end

    if SpeedMode == "WalkSpeed" then
        Hum.WalkSpeed = SpeedValue
    elseif SpeedMode == "TpSpeed" then
        -- Exemplo limpo para uso no seu próprio jogo
        Hum.WalkSpeed = SpeedValue
    end
end
local function StartSpeedLoop()
    if SpeedLoopConnection then return end

    SpeedLoopConnection = RunService.Heartbeat:Connect(function()
        if not SpeedToggleState then return end

        pcall(function()
            local Char = Player.Character
            local Hum = Char and Char:FindFirstChildOfClass("Humanoid")
            local Root = Char and Char:FindFirstChild("HumanoidRootPart")

            if not (Hum and Root) then return end

            if SpeedMode == "WalkSpeed" then
                Hum.WalkSpeed = SpeedValue

            elseif SpeedMode == "TpSpeed (bypass)" then
                -- ✅ LÓGICA REAL (a que você queria)
                Hum.WalkSpeed = 0

                if Hum.MoveDirection.Magnitude > 0 then
                    Root.CFrame = Root.CFrame + (Hum.MoveDirection * (SpeedValue / 20))
                end
            end
        end)
    end)

    Notifier.new({
        Title = "[!] - Spedd",
        Content = "Ligado (" .. SpeedMode .. ")",
        Duration = 2,
        Icon = "rbxassetid://117056629401480"
    })
end
local function StopSpeedLoop()
    if SpeedLoopConnection then
        SpeedLoopConnection:Disconnect()
        SpeedLoopConnection = nil
    end

    pcall(function()
        local Char = Player.Character
        local Hum = Char and Char:FindFirstChildOfClass("Humanoid")

        if Hum then
            Hum.WalkSpeed = 16
        end
    end)

    Notifier.new({
        Title = "Movimento",
        Content = "Desligado",
        Duration = 2,
        Icon = "rbxassetid://117056629401480"
    })
end
local function ToggleSpeed(state)
    SpeedToggleState = state

    if state then
        StartSpeedLoop()
        ApplySpeed()
    else
        StopSpeedLoop()
    end
end
MovementSection:AddToggle({
    Name = "• Speed",
    Default = false,
    Flag = "Movement_EnableSpeed",
    Callback = function(state)
        ToggleSpeed(state)
    end
})
MovementSection:AddDropdown({
    Name = "Método",
    Default = SpeedMode,
    Values = { "WalkSpeed", "TpSpeed (bypass)" },
    Flag = "Movement_SpeedMode",
    Callback = function(selection)
        SpeedMode = selection
        ApplySpeed()

        if SpeedToggleState then
            Notifier.new({
                Title = "[ ! ] - Speed On",
                Content = "Método: " .. tostring(selection),
                Duration = 2,
                Icon = "rbxassetid://117056629401480"
            })
        end
    end
})
-- Uma notificação só depois que o slider para de mudar (evita 20 avisos por arrasto).
local NotifySpeedDebounced = FiveSync:Debounce(0.25, function(value)
    Notifier.new({
        Title = "Speed",
        Content = "Velocidade Ajustada: " .. tostring(value),
        Duration = 1.5,
        Icon = "rbxassetid://117056629401480"
    })
end)

SliderSpeedAPI = MovementSection:AddSlider({
    Name = "Speed Force",
    Default = SpeedValue,
    Min = 5,
    Max = 150,
    Type = "",
    Round = 0,
    Flag = "Movement_SpeedValue",
    Callback = function(newValue)
        if SpeedSyncing then return end
        SpeedSyncing = true

        local roundedValue = math.floor(tonumber(newValue) or 16)
        SpeedValue = roundedValue

        if TextboxSpeedAPI and TextboxSpeedAPI.SetValue then
            TextboxSpeedAPI:SetValue(tostring(roundedValue))
        end

        ApplySpeed()

        NotifySpeedDebounced(roundedValue)

        SpeedSyncing = false
    end
})
TextboxSpeedAPI = MovementSection:AddTextBox({
    Name = "Speed por Texto",
    Default = tostring(SpeedValue),
    Placeholder = tostring(SpeedValue),
    Numeric = true,
    Flag = "Movement_SpeedText",
    Callback = function(text)
        if SpeedSyncing then return end
        SpeedSyncing = true

        local value = tonumber(text)

        if value and value >= 5 and value <= 150 then
            value = math.floor(value)
            SpeedValue = value

            if SliderSpeedAPI and SliderSpeedAPI.SetValue then
                SliderSpeedAPI:SetValue(value)
            end

            ApplySpeed()
        else
            if TextboxSpeedAPI and TextboxSpeedAPI.SetValue then
                TextboxSpeedAPI:SetValue(tostring(SpeedValue))
            end
        end

        SpeedSyncing = false
    end
})




-- Jump


local JumpSection = MovementTab:DrawSection({
    Name = "- Jump",
    Position = "right"
})
JumpSection:AddParagraph({
    Title = "< • > - Config Junp",
    Content = "Varios modulos de De Pulo"
})
local JumpState = {
    Force = false,
    Double = false,
    Infinite = false,
    Auto = false,
    Bunny = false
}
local JumpPowerValue = 50
local JumpConnections = {}
local JumpTextboxAPI
local JumpSliderAPI
local updating = false
local function Notify(txt)
    Notifier.new({
        Title = "[!] - Jump",
        Content = txt,
        Duration = 1.5,
        Icon = "rbxassetid://117056629401480"
    })
end
local function GetHumanoid()
    local char = Player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end
local function GetRoot()
    local char = Player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function ApplyJump()
    local hum = GetHumanoid()
    if not hum then return end

    hum.UseJumpPower = true
    hum.JumpPower = JumpState.Force and JumpPowerValue or 50
end
local function ClearJumpConnections()
    for _, v in ipairs(JumpConnections) do
        pcall(function() v:Disconnect() end)
    end
    table.clear(JumpConnections)
end
local function SetupJump()
    ClearJumpConnections()

    local hum = GetHumanoid()
    if not hum then return end

    ApplyJump()

    -- AUTO JUMP
    if JumpState.Auto then
        table.insert(JumpConnections, hum.StateChanged:Connect(function(_, state)
            if state == Enum.HumanoidStateType.Landed then
                task.wait(0.05)
                if JumpState.Auto then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end))
    end

    -- DOUBLE JUMP
    if JumpState.Double then
        local canDouble = false

        table.insert(JumpConnections, hum.StateChanged:Connect(function(_, state)
            if state == Enum.HumanoidStateType.Freefall then
                canDouble = true
            elseif state == Enum.HumanoidStateType.Landed then
                canDouble = false
            end
        end))

        table.insert(JumpConnections, UserInputService.JumpRequest:Connect(function()
            if JumpState.Double and canDouble then
                canDouble = false
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end))
    end

    -- INFINITE JUMP
    if JumpState.Infinite then
        table.insert(JumpConnections, UserInputService.JumpRequest:Connect(function()
            if JumpState.Infinite then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end))
    end
end
local BunnyLoop = nil
local function StartBunny()
    if BunnyLoop then return end

    BunnyLoop = RunService.Heartbeat:Connect(function()
        if not JumpState.Bunny then return end

        local hum = GetHumanoid()
        local root = GetRoot()

        if not (hum and root) then return end

        if hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude > 0 then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)

            local move = hum.MoveDirection
            root.AssemblyLinearVelocity = Vector3.new(
                move.X * 22,
                38,
                move.Z * 22
            )
        end
    end)
end
local function StopBunny()
    if BunnyLoop then
        BunnyLoop:Disconnect()
        BunnyLoop = nil
    end
end
Player.CharacterAdded:Connect(function()
    task.wait(0.2)
    ApplyJump()
    SetupJump()

    if JumpState.Bunny then
        StartBunny()
    end
end)
JumpSection:AddToggle({
    Name = "Força Do Pulo",
    Default = false,
    Flag = "JumpForce",
    Callback = function(state)
        JumpState.Force = state
        ApplyJump()
        Notify(state and "Jump Force ON" or "Jump Force OFF")
    end
})
JumpSliderAPI = JumpSection:AddSlider({
    Name = "Força do Pulo",
    Default = JumpPowerValue,
    Min = 25,
    Max = 120,
    Flag = "JumpPower",
    Callback = function(value)
        if updating then return end
        updating = true

        local v = math.floor(value)
        JumpPowerValue = v

        if JumpTextboxAPI then
            JumpTextboxAPI:SetValue(tostring(v))
        end

        ApplyJump()

        updating = false
    end
})
JumpTextboxAPI = JumpSection:AddTextBox({
    Name = "Força por Texto",
    Default = tostring(JumpPowerValue),
    Numeric = true,
    Flag = "JumpPowerText",
    Callback = function(text)
        if updating then return end
        updating = true

        local v = tonumber(text)

        if v and v >= 25 and v <= 120 then
            v = math.floor(v)
            JumpPowerValue = v

            if JumpSliderAPI then
                JumpSliderAPI:SetValue(v)
            end

            ApplyJump()
        else
            JumpTextboxAPI:SetValue(tostring(JumpPowerValue))
        end

        updating = false
    end
})
JumpSection:AddToggle({
    Name = "Pulo Infinito",
    Default = false,
    Flag = "DoubleJump",
    Callback = function(state)
        JumpState.Double = state
        SetupJump()
        Notify("Double Jump: " .. tostring(state))
    end
})
JumpSection:AddToggle({
    Name = "Pulo Infinito v2",
    Default = false,
    Flag = "InfiniteJump",
    Callback = function(state)
        JumpState.Infinite = state
        SetupJump()
        Notify("Infinite Jump: " .. tostring(state))
    end
})
JumpSection:AddToggle({
    Name = "Auto Jump",
    Default = false,
    Flag = "AutoJump",
    Callback = function(state)
        JumpState.Auto = state
        SetupJump()
        Notify("Auto Jump: " .. tostring(state))
    end
})
JumpSection:AddToggle({
    Name = "Bunny Hop",
    Default = false,
    Flag = "BunnyHop",
    Callback = function(state)
        JumpState.Bunny = state

        if state then
            StartBunny()
        else
            StopBunny()
        end

        Notify("Bunny Hop: " .. tostring(state))
    end
})





-- Spin


local SpinSection = MovementTab:DrawSection({
    Name = "- Spin",
    Position = "left"
})
SpinSection:AddParagraph({
    Title = "< • > - Spin",
    Content = "Gira o personagem - Evitar Balas."
})
local SpinEnabled = false
local SpinSpeed = 1080
local SpinConnection = nil
local function SpinNotify(text)
    Notifier.new({
        Title = "Spin",
        Content = text,
        Duration = 1.5,
        Icon = "rbxassetid://117056629401480"
    })
end
local function GetCharacterHumanoidRoot()
    local char = Player.Character
    if not char then return nil, nil end
    return char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
end
local function StopSpin()
    SpinEnabled = false

    if SpinConnection then
        SpinConnection:Disconnect()
        SpinConnection = nil
    end

    local hum = GetCharacterHumanoidRoot()
    if hum then
        hum.AutoRotate = true
    end

    SpinNotify("Desligado.")
end
local function StartSpin()
    if SpinConnection then return end

    SpinEnabled = true

    SpinConnection = RunService.Heartbeat:Connect(function(dt)
        if not SpinEnabled then return end

        local hum, root = GetCharacterHumanoidRoot()
        if not (hum and root) then return end

        hum.AutoRotate = false
        root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(SpinSpeed * dt), 0)
    end)

    SpinNotify("Ligado.")
end
SpinSection:AddToggle({
    Name = "Ativar Spin",
    Default = false,
    Flag = "Movement_SpinEnabled",
    Callback = function(state)
        if state then
            StartSpin()
        else
            StopSpin()
        end
    end
})
local SpinNotifyDebounced = FiveSync:Debounce(0.25, function(v)
    SpinNotify("Velocidade: " .. tostring(v))
end)

SpinSection:AddSlider({
    Name = "Velocidade do Spin",
    Default = SpinSpeed,
    Min = 0,
    Max = 3600,
    Type = "",
    Round = 0,
    Flag = "Movement_SpinSpeed",
    Callback = function(value)
        SpinSpeed = math.floor(value)
        if SpinEnabled then
            SpinNotifyDebounced(SpinSpeed)
        end
    end
})
Player.CharacterAdded:Connect(function()
    task.wait(0.2)
    if SpinEnabled then
        StartSpin()
    end
end)




-- Fly


local FlySection = MovementTab:DrawSection({
    Name = "- Fly",
    Position = "right"
})
FlySection:AddParagraph({
    Title = "< • > - Fly Control",
    Content = "Voo Mobile e Pc"
})
local velocidadeVoo = 50
local voando = false
local vooConexao
local FlySlider, FlyTextbox
local FlySyncing = false
local descendo = false
local CoreGui = game:GetService("CoreGui")
local function NotifyFly(title, text, time)
    Notifier.new({
        Title = title,
        Content = text,
        Duration = time or 1.5,
        Icon = "rbxassetid://117056629401480"
    })
end
local DescerBTN = CoreGui:FindFirstChild("FlyDownBTN")
if not DescerBTN then
    DescerBTN = Instance.new("TextButton")
    DescerBTN.Name = "FlyDownBTN"
    DescerBTN.Size = UDim2.new(0,120,0,50)
    DescerBTN.Position = UDim2.new(1,-140,1,-160)
    DescerBTN.Text = "DESCER"
    DescerBTN.BackgroundColor3 = Color3.fromRGB(220,0,20)
    DescerBTN.TextColor3 = Color3.new(1,1,1)
    DescerBTN.Visible = false
    DescerBTN.Parent = CoreGui

    DescerBTN.MouseButton1Down:Connect(function()
        descendo = true
    end)

    DescerBTN.MouseButton1Up:Connect(function()
        descendo = false
    end)
end
local function AtivarVoo()
    if vooConexao then return end

    voando = true
    NotifyFly("FLY", "Ativado!")

    local Char = Player.Character or Player.CharacterAdded:Wait()
    local Root = Char:WaitForChild("HumanoidRootPart")
    local Hum = Char:WaitForChild("Humanoid")

    Hum.PlatformStand = true
    DescerBTN.Visible = true

    local gyro = Instance.new("BodyGyro")
    gyro.MaxTorque = Vector3.new(9e9,9e9,9e9)
    gyro.P = 20000
    gyro.Parent = Root

    local vel = Instance.new("BodyVelocity")
    vel.MaxForce = Vector3.new(9e9,9e9,9e9)
    vel.Parent = Root

    vooConexao = RunService.RenderStepped:Connect(function()
        if not voando or Hum.Health <= 0 then
            if vooConexao then vooConexao:Disconnect() vooConexao = nil end
            gyro:Destroy()
            vel:Destroy()
            DescerBTN.Visible = false
            return
        end

        gyro.CFrame = workspace.CurrentCamera.CFrame

        local vertical = 0

        if Hum.Jump then
            vertical = velocidadeVoo
        elseif descendo then
            vertical = -velocidadeVoo
        end

        local move = Hum.MoveDirection * velocidadeVoo

        vel.Velocity = Vector3.new(
            move.X,
            vertical,
            move.Z
        )
    end)
end
local function DesativarVoo()
    voando = false

    if vooConexao then
        vooConexao:Disconnect()
        vooConexao = nil
    end

    pcall(function()
        local char = Player.Character
        if not char then return end

        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if root then
            for _,v in pairs(root:GetChildren()) do
                if v:IsA("BodyGyro") or v:IsA("BodyVelocity") then
                    v:Destroy()
                end
            end
        end

        if hum then
            hum.PlatformStand = false
        end
    end)

    descendo = false
    DescerBTN.Visible = false

    NotifyFly("FLY", "Desligado!")
end
local function ToggleFly(state)
    if state then
        AtivarVoo()
    else
        DesativarVoo()
    end
end
Player.CharacterAdded:Connect(function()
    task.wait(0.3)
    if voando then
        AtivarVoo()
    end
end)
FlySection:AddToggle({
    Name = "Ativar Fly",
    Default = false,
    Flag = "Movement_Fly",
    Callback = ToggleFly
})
local NotifyFlyDebounced = FiveSync:Debounce(0.25, function(v)
    NotifyFly("FLY", "Velocidade: "..v, 1.5)
end)

FlySlider = FlySection:AddSlider({
    Name = "Velocidade do Fly",
    Default = velocidadeVoo,
    Min = 10,
    Max = 500,
    Flag = "Movement_FlySpeed",
    Callback = function(v)
        if FlySyncing then return end
        FlySyncing = true

        local val = math.floor(v)
        velocidadeVoo = val

        if FlyTextbox then
            FlyTextbox:SetValue(tostring(val))
        end

        NotifyFlyDebounced(val)

        FlySyncing = false
    end
})
FlyTextbox = FlySection:AddTextBox({
    Flag = "FlySection_VelocidadeporTexto",
    Name = "Velocidade por Texto",
    Placeholder = tostring(velocidadeVoo),
    Callback = function(text)
        if FlySyncing then return end
        FlySyncing = true

        local value = tonumber(text)

        if value and value >= 10 and value <= 500 then
            velocidadeVoo = value

            if FlySlider then
                FlySlider:SetValue(value)
            end

            NotifyFly("FLY", "Velocidade: "..value, 1.5)
        else
            NotifyFly("FLY", "Valor inválido!", 2)
            FlyTextbox:SetValue(tostring(velocidadeVoo))
        end

        FlySyncing = false
    end
})




-- SkyBase

local SkySection = MovementTab:DrawSection({
    Name = "- Sky Base",
    Position = "left"
})
SkySection:AddParagraph({
    Title = "< • > - Sky Base",
    Content = "Uma Base no Ceu!"
})
local SkyEnabled = false
local SkyLocked = false
local SkyHeight = 20
local SkyConn
local LockedY = nil
local function NotifySky(txt)
    Notifier.new({
        Title = "Sky Base",
        Content = txt,
        Duration = 1.5,
        Icon = "rbxassetid://117056629401480"
    })
end
local function GetChar()
    return Player.Character
end
local function GetRoot()
    local char = GetChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function GetGroundY(root)
    local origin = root.Position
    local direction = Vector3.new(0, -500, 0)

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {GetChar()}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist

    local result = workspace:Raycast(origin, direction, rayParams)

    if result then
        return result.Position.Y
    else
        return root.Position.Y
    end
end
local function StartSky()
    if SkyConn then return end

    SkyConn = RunService.Heartbeat:Connect(function()
        if not SkyEnabled then return end

        local root = GetRoot()
        if not root then return end

        local targetY

        if SkyLocked and LockedY then
            targetY = LockedY
        else
            local groundY = GetGroundY(root)
            targetY = groundY + SkyHeight
        end

        -- mantém movimento normal no X/Z
        root.Velocity = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)

        -- aplica altura
        root.CFrame = CFrame.new(
            root.Position.X,
            targetY,
            root.Position.Z
        )
    end)

    NotifySky("Ativado")
end
local function StopSky()
    if SkyConn then
        SkyConn:Disconnect()
        SkyConn = nil
    end

    LockedY = nil

    NotifySky("Desligado")
end
local function ToggleSky(state)
    SkyEnabled = state

    if state then
        StartSky()
    else
        StopSky()
    end
end
Player.CharacterAdded:Connect(function()
    task.wait(0.3)

    if SkyEnabled then
        StartSky()
    end
end)
SkySection:AddToggle({
    Name = "Ativar Sky Base",
    Default = false,
    Flag = "Movement_SkyBase",
    Callback = ToggleSky
})
local NotifySkyDebounced = FiveSync:Debounce(0.25, function(v)
    NotifySky("Altura: " .. tostring(v))
end)

SkySection:AddSlider({
    Name = "Altura",
    Default = SkyHeight,
    Min = 5,
    Max = 200,
    Flag = "Movement_SkyHeight",
    Callback = function(v)
        SkyHeight = math.floor(v)
        NotifySkyDebounced(SkyHeight)
    end
})
SkySection:AddToggle({
    Name = "Travar Altura",
    Default = false,
    Flag = "Movement_SkyLock",
    Callback = function(state)
        SkyLocked = state

        if state then
            local root = GetRoot()
            if root then
                LockedY = root.Position.Y
            end
            NotifySky("Altura Travada")
        else
            LockedY = nil
            NotifySky("Altura Dinâmica")
        end
    end
})

