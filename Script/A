local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

-- Configurações Globais
local Config = {
    Enabled = false,
    SelfESP = false,
    TeamCheck = false,
    MaxDistance = 1000,
    DynamicScaling = true,
    RefreshRate = 0, -- 0 para máximo FPS
    
    Box = { Enabled = false, Type = "Full", Color = Color3.fromRGB(255, 0, 0), Thickness = 1, Transparency = 1, Outline = true },
    Tracer = { Enabled = false, Origin = "Bottom", Color = Color3.fromRGB(255, 0, 0), Thickness = 1, Transparency = 1 },
    Life = { Enabled = false, Type = "Bar", Color = Color3.fromRGB(0, 255, 0), Transparency = 1 },
    Info = { Name = false, Distance = false, Item = false, Color = Color3.fromRGB(255, 255, 255), Size = 14, Transparency = 1 },
    Skeleton = { Enabled = false, Color = Color3.fromRGB(255, 255, 255), Thickness = 1, Transparency = 1 },
    Rainbow = { Enabled = false, Speed = 0.05, ApplyToBox = true, ApplyToTracer = true, ApplyToText = true, ApplyToSkeleton = true }
}

local ESP_Cache = {}
local rainbowHue = 0
local bodyConnections = {
    R15 = {
        {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"LowerTorso", "LeftUpperLeg"}, {"LowerTorso", "RightUpperLeg"},
        {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
        {"UpperTorso", "LeftUpperArm"}, {"UpperTorso", "RightUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
        {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"}
    },
    R6 = {
        {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"}, {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
    }
}
-- Função de Criação Segura
local function CreateDrawing(type, properties)
    local drawing = Drawing.new(type)
    for prop, val in pairs(properties) do
        pcall(function() drawing[prop] = val end)
    end
    return drawing
end
-- Função de Limpeza Absoluta (Garante que nada fique na tela)
local function ClearESP(player)
    local data = ESP_Cache[player]
    if data then
        pcall(function()
            -- Remove Box
            if data.Box then
                for _, line in pairs(data.Box) do line.Visible = false; line:Remove() end
            end
            -- Remove Tracer
            if data.Tracer then data.Tracer.Visible = false; data.Tracer:Remove() end
            -- Remove Textos
            if data.Name then data.Name.Visible = false; data.Name:Remove() end
            if data.Distance then data.Distance.Visible = false; data.Distance:Remove() end
            if data.Item then data.Item.Visible = false; data.Item:Remove() end
            -- Remove Vida
            if data.HealthBar then data.HealthBar.Visible = false; data.HealthBar:Remove() end
            if data.HealthBarOutline then data.HealthBarOutline.Visible = false; data.HealthBarOutline:Remove() end
            if data.HealthText then data.HealthText.Visible = false; data.HealthText:Remove() end
            -- Remove Esqueleto
            if data.Skeleton then
                for _, line in pairs(data.Skeleton) do line.Visible = false; line:Remove() end
            end
        end)
        ESP_Cache[player] = nil
    end
end
-- Inicialização do Cache para um Jogador
local function InitPlayerESP(player)
    if ESP_Cache[player] then ClearESP(player) end
    
    local data = {
        Box = {},
        Skeleton = {}
    }
    
    -- Criar 8 linhas para suportar tanto Full quanto Corner
    for i = 1, 8 do data.Box["Line"..i] = CreateDrawing("Line", {Thickness = 1, Visible = false, Transparency = 1}) end
    data.Tracer = CreateDrawing("Line", {Thickness = 1, Visible = false, Transparency = 1})
    data.Name = CreateDrawing("Text", {Size = 14, Center = true, Outline = true, Visible = false})
    data.Distance = CreateDrawing("Text", {Size = 14, Center = true, Outline = true, Visible = false})
    data.Item = CreateDrawing("Text", {Size = 14, Center = true, Outline = true, Visible = false})
    data.HealthBar = CreateDrawing("Square", {Filled = true, Visible = false})
    data.HealthBarOutline = CreateDrawing("Square", {Filled = false, Color = Color3.new(0,0,0), Visible = false})
    data.HealthText = CreateDrawing("Text", {Size = 14, Center = true, Outline = true, Visible = false})
    
    ESP_Cache[player] = data
end
-- Loop de Monitoramento de Limpeza (Roda independente para garantir remoção)
RunService.Heartbeat:Connect(function()
    for player, _ in pairs(ESP_Cache) do
        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        -- Se o player saiu, o char sumiu ou o player morreu -> LIMPA TUDO
        if not player.Parent or not char or not hum or hum.Health <= 0 then
            ClearESP(player)
        end
    end
end)
-- Loop de Renderização
RunService.RenderStepped:Connect(function()
    if Config.Rainbow.Enabled then rainbowHue = (rainbowHue + Config.Rainbow.Speed) % 1 end
    local rainbowColor = Color3.fromHSV(rainbowHue, 1, 1)

    if not Config.Enabled then
        for _, data in pairs(ESP_Cache) do
            pcall(function()
                for _, v in pairs(data.Box) do v.Visible = false end
                data.Tracer.Visible = false
                data.Name.Visible = false
                data.Distance.Visible = false
                data.Item.Visible = false
                data.HealthBar.Visible = false
                data.HealthBarOutline.Visible = false
                data.HealthText.Visible = false
                for _, v in pairs(data.Skeleton) do v.Visible = false end
            end)
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        -- Ignorar Self se configurado
        if not Config.SelfESP and player == LocalPlayer then continue end
        
        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        -- Verificação básica de validade
        if not char or not hum or not hrp or hum.Health <= 0 then continue end
        if Config.TeamCheck and player.Team == LocalPlayer.Team and player ~= LocalPlayer then continue end

        -- Inicializa se necessário
        if not ESP_Cache[player] then InitPlayerESP(player) end
        local data = ESP_Cache[player]
        
        pcall(function()
            local head = char:FindFirstChild("Head")
            if not head then return end
            
            local headPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local footPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, hum.HipHeight + (hrp.Size.Y / 2) + 0.5, 0))
            local distance = (Camera.CFrame.Position - hrp.Position).Magnitude

            if onScreen and distance <= Config.MaxDistance then
                local height = math.abs(headPos.Y - footPos.Y)
                local width = height / 2
                local x, y = headPos.X - width / 2, headPos.Y
                
                -- Cores Dinâmicas
                local boxColor = (Config.Rainbow.Enabled and Config.Rainbow.ApplyToBox) and rainbowColor or Config.Box.Color
                local textColor = (Config.Rainbow.Enabled and Config.Rainbow.ApplyToText) and rainbowColor or Config.Info.Color
                local skelColor = (Config.Rainbow.Enabled and Config.Rainbow.ApplyToSkeleton) and rainbowColor or Config.Skeleton.Color
                local tracerColor = (Config.Rainbow.Enabled and Config.Rainbow.ApplyToTracer) and rainbowColor or Config.Tracer.Color

                -- Box Render
                if Config.Box.Enabled then
                    if Config.Box.Type == "Full" then
                        data.Box.Line1.From, data.Box.Line1.To = Vector2.new(x, y), Vector2.new(x + width, y)
                        data.Box.Line2.From, data.Box.Line2.To = Vector2.new(x, y), Vector2.new(x, y + height)
                        data.Box.Line3.From, data.Box.Line3.To = Vector2.new(x + width, y), Vector2.new(x + width, y + height)
                        data.Box.Line4.From, data.Box.Line4.To = Vector2.new(x, y + height), Vector2.new(x + width, y + height)
                        for i=1, 4 do 
                            local l = data.Box["Line"..i]
                            l.Visible, l.Color, l.Thickness, l.Transparency = true, boxColor, Config.Box.Thickness, Config.Box.Transparency 
                        end
                        for i=5, 8 do data.Box["Line"..i].Visible = false end
                    else -- Corner
                        local cl = width / 4
                        data.Box.Line1.From, data.Box.Line1.To = Vector2.new(x, y), Vector2.new(x + cl, y)
                        data.Box.Line2.From, data.Box.Line2.To = Vector2.new(x, y), Vector2.new(x, y + cl)
                        data.Box.Line3.From, data.Box.Line3.To = Vector2.new(x + width, y), Vector2.new(x + width - cl, y)
                        data.Box.Line4.From, data.Box.Line4.To = Vector2.new(x + width, y), Vector2.new(x + width, y + cl)
                        data.Box.Line5.From, data.Box.Line5.To = Vector2.new(x, y + height), Vector2.new(x + cl, y + height)
                        data.Box.Line6.From, data.Box.Line6.To = Vector2.new(x, y + height), Vector2.new(x, y + height - cl)
                        data.Box.Line7.From, data.Box.Line7.To = Vector2.new(x + width, y + height), Vector2.new(x + width - cl, y + height)
                        data.Box.Line8.From, data.Box.Line8.To = Vector2.new(x + width, y + height), Vector2.new(x + width, y + height - cl)
                        for i=1, 8 do 
                            local l = data.Box["Line"..i]
                            l.Visible, l.Color, l.Thickness, l.Transparency = true, boxColor, Config.Box.Thickness, Config.Box.Transparency 
                        end
                    end
                else
                    for i=1, 8 do data.Box["Line"..i].Visible = false end
                end

                -- Tracer Render
                if Config.Tracer.Enabled then
                    local origin = Config.Tracer.Origin == "Top" and Vector2.new(Camera.ViewportSize.X/2, 0) or Config.Tracer.Origin == "Bottom" and Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y) or UserInputService:GetMouseLocation()
                    data.Tracer.From, data.Tracer.To, data.Tracer.Color, data.Tracer.Thickness, data.Tracer.Transparency, data.Tracer.Visible = origin, Vector2.new(headPos.X, headPos.Y + height/2), tracerColor, Config.Tracer.Thickness, Config.Tracer.Transparency, true
                else data.Tracer.Visible = false end

                -- Info Render
                local scale = Config.DynamicScaling and math.max(0.4, 1 - (distance/Config.MaxDistance)) or 1
                local ts = Config.Info.Size * scale
                local off = y - 5
                
                if Config.Info.Name then 
                    data.Name.Text, data.Name.Position, data.Name.Color, data.Name.Size, data.Name.Transparency, data.Name.Visible = player.DisplayName or player.Name, Vector2.new(headPos.X, off - ts), textColor, ts, Config.Info.Transparency, true
                    off = off - ts - 2
                else data.Name.Visible = false end
                
                if Config.Info.Distance then 
                    data.Distance.Text, data.Distance.Position, data.Distance.Color, data.Distance.Size, data.Distance.Transparency, data.Distance.Visible = string.format("[%dM]", distance), Vector2.new(headPos.X, off - ts), textColor, ts, Config.Info.Transparency, true
                    off = off - ts - 2
                else data.Distance.Visible = false end
                
                if Config.Info.Item then
                    local tool = char:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
                    if tool then 
                        data.Item.Text, data.Item.Position, data.Item.Color, data.Item.Size, data.Item.Transparency, data.Item.Visible = "["..tool.Name.."]", Vector2.new(headPos.X, off - ts), textColor, ts, Config.Info.Transparency, true 
                    else data.Item.Visible = false end
                else data.Item.Visible = false end

                -- Life Render
                if Config.Life.Enabled then
                    local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    if Config.Life.Type == "Bar" then
                        data.HealthBarOutline.Position, data.HealthBarOutline.Size, data.HealthBarOutline.Transparency, data.HealthBarOutline.Visible = Vector2.new(x - 6, y), Vector2.new(4, height), Config.Life.Transparency, true
                        data.HealthBar.Position, data.HealthBar.Size, data.HealthBar.Color, data.HealthBar.Transparency, data.HealthBar.Visible = Vector2.new(x - 5, y + (height * (1-hp))), Vector2.new(2, height * hp), Color3.fromRGB(255,0,0):lerp(Color3.fromRGB(0,255,0), hp), Config.Life.Transparency, true
                        data.HealthText.Visible = false
                    else
                        data.HealthText.Text, data.HealthText.Position, data.HealthText.Color, data.HealthText.Size, data.HealthText.Transparency, data.HealthText.Visible = math.floor(hum.Health).." HP", Vector2.new(headPos.X, y + height + 5), textColor, ts, Config.Life.Transparency, true
                        data.HealthBar.Visible, data.HealthBarOutline.Visible = false, false
                    end
                else data.HealthBar.Visible, data.HealthBarOutline.Visible, data.HealthText.Visible = false, false, false end

                -- Skeleton Render
                if Config.Skeleton.Enabled then
                    local connections = bodyConnections[hum.RigType.Name]
                    if connections then
                        if #data.Skeleton == 0 then for _=1, #connections do table.insert(data.Skeleton, CreateDrawing("Line", {Thickness = Config.Skeleton.Thickness, Visible = false})) end end
                        for i, conn in ipairs(connections) do
                            local pA, pB = char:FindFirstChild(conn[1]), char:FindFirstChild(conn[2])
                            if pA and pB then
                                local vA, oA = Camera:WorldToViewportPoint(pA.Position)
                                local vB, oB = Camera:WorldToViewportPoint(pB.Position)
                                if oA and oB then 
                                    local l = data.Skeleton[i]
                                    l.From, l.To, l.Color, l.Thickness, l.Transparency, l.Visible = Vector2.new(vA.X, vA.Y), Vector2.new(vB.X, vB.Y), skelColor, Config.Skeleton.Thickness, Config.Skeleton.Transparency, true 
                                else data.Skeleton[i].Visible = false end
                            else data.Skeleton[i].Visible = false end
                        end
                    end
                else for _, v in pairs(data.Skeleton) do v.Visible = false end end
            else
                -- Fora da tela ou distância
                for _, v in pairs(data.Box) do v.Visible = false end
                data.Tracer.Visible, data.Name.Visible, data.Distance.Visible, data.Item.Visible, data.HealthBar.Visible, data.HealthBarOutline.Visible, data.HealthText.Visible = false, false, false, false, false, false, false
                for _, v in pairs(data.Skeleton) do v.Visible = false end
            end
        end)
    end
end)

local Tab = VisualContainer:DrawTab({
	Name = " Esp  ",
	Type = "Double",
	EnableScrolling = true,
});


-- Seção Principal
local SecMain = Tab:DrawSection({ Name = "Configurações Globais", Position = 'left' });
