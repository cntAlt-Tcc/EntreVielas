-- EXIBIR TEMPO RESTANTE DA KEY NO RODAPÉ (sem sobrecarregar a API)
-- ==============================================================
if _G.LoaderExpireAt then
    local function updateExpireText()
        local now = os.time()
        local remaining = _G.LoaderExpireAt - now
        local expireText = ""

        if remaining <= 0 then
            expireText = "Expirada"
        elseif remaining >= 86400 * 365 then  -- mais de 1 ano
            expireText = "Nunca expira"
        else
            local days = math.floor(remaining / 86400)
            local hours = math.floor((remaining % 86400) / 3600)
            if days > 0 then
                expireText = string.format("%d dias", days)
                if hours > 0 then
                    expireText = expireText .. string.format(" e %dh", hours)
                end
            else
                local minutes = math.floor((remaining % 3600) / 60)
                if hours > 0 then
                    expireText = string.format("%dh %dm", hours, minutes)
                else
                    expireText = string.format("%dm", minutes)
                end
            end
        end

        -- Atualiza o campo "ExpireDate" no rodapé da UI
        Window:Update({ ExpireDate = expireText })
    end

    updateExpireText()  -- atualiza imediatamente

    -- Atualiza localmente a cada 5 minutos (sem chamar a API)
    task.spawn(function()
        while true do
            task.wait(300) -- 5 minutos
            updateExpireText()
        end
    end)
else
    -- Caso não tenha informação de expiração (key permanente ou erro)
    Window:Update({ ExpireDate = "Nunca expira" })
end
