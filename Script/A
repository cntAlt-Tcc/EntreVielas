local CameraSection = WorldTab:DrawSection({
    Name = "Câmera",
    Position = "left"
})

CameraSection:AddParagraph({
    Title = "3ª Pessoa",
    Content = "Força câmera livre (anti primeira pessoa)"
})

--========================
-- VARIÁVEIS
--========================
local ThirdEnabled = false
local MaxZoom = 999

local CameraConn

--========================
-- NOTIFY
--========================
local function NotifyCam(txt)
    Notifier.new({
        Title = "Câmera",
        Content = txt,
        Duration = 1.5,
        Icon = "rbxassetid://95629194286677"
    })
end

--========================
-- APLICAR CONFIG
--========================
local function ApplyCamera()
    local plr = Players.LocalPlayer

    plr.CameraMode = Enum.CameraMode.Classic
    plr.CameraMaxZoomDistance = MaxZoom

    -- opcional (evita travar muito perto)
    if plr.CameraMinZoomDistance < 5 then
        plr.CameraMinZoomDistance = 5
    end
end

--========================
-- LOOP ANTI RESET
--========================
local function StartCameraLoop()
    if CameraConn then return end

    CameraConn = RunService.RenderStepped:Connect(function()
        if not ThirdEnabled then return end
        ApplyCamera()
    end)
end

local function StopCameraLoop()
    if CameraConn then
        CameraConn:Disconnect()
        CameraConn = nil
    end
end

--========================
-- TOGGLE
--========================
local function ToggleThird(state)
    ThirdEnabled = state

    if state then
        ApplyCamera()
        StartCameraLoop()
        NotifyCam("3ª Pessoa Ativada")
    else
        StopCameraLoop()
        NotifyCam("Desativado")
    end
end

--========================
-- RESPAWN FIX
--========================
Player.CharacterAdded:Connect(function()
    task.wait(0.2)
    if ThirdEnabled then
        ApplyCamera()
    end
end)

CameraSection:AddToggle({
    Name = "Forçar 3ª Pessoa",
    Default = false,
    Flag = "Camera_ThirdPerson",
    Callback = ToggleThird
})

CameraSection:AddSlider({
    Name = "Distância Máxima",
    Default = MaxZoom,
    Min = 50,
    Max = 2000,
    Flag = "Camera_MaxZoom",
    Callback = function(v)
        MaxZoom = math.floor(v)
        if ThirdEnabled then
            ApplyCamera()
        end
        NotifyCam("Zoom: "..MaxZoom)
    end
})
