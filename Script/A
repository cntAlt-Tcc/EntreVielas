-- Sistema FullBright
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local fullBrightActive = false
local fullBrightConnection = nil

-- Salvar valores originais
local originalValues = {
    Brightness = Lighting.Brightness,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    Ambient = Lighting.Ambient,
    TimeOfDay = Lighting.TimeOfDay,
    FogStart = Lighting.FogStart,
    FogEnd = Lighting.FogEnd,
    FogColor = Lighting.FogColor,
    GlobalShadows = Lighting.GlobalShadows
}

-- Função para ativar FullBright
local function enableFullBright()
    if fullBrightConnection then
        fullBrightConnection:Disconnect()
        fullBrightConnection = nil
    end
    
    fullBrightConnection = RunService.RenderStepped:Connect(function()
        Lighting.Brightness = 2
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.TimeOfDay = "14:00:00"
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000
        Lighting.FogColor = Color3.fromRGB(255, 255, 255)
        Lighting.GlobalShadows = false
    end)
end

-- Função para desativar FullBright
local function disableFullBright()
    if fullBrightConnection then
        fullBrightConnection:Disconnect()
        fullBrightConnection = nil
    end
    
    -- Restaurar valores originais
    Lighting.Brightness = originalValues.Brightness
    Lighting.OutdoorAmbient = originalValues.OutdoorAmbient
    Lighting.Ambient = originalValues.Ambient
    Lighting.TimeOfDay = originalValues.TimeOfDay
    Lighting.FogStart = originalValues.FogStart
    Lighting.FogEnd = originalValues.FogEnd
    Lighting.FogColor = originalValues.FogColor
    Lighting.GlobalShadows = originalValues.GlobalShadows
end

-- Função principal do toggle
local function toggleFullBright(enabled)
    fullBrightActive = enabled
    
    if enabled then
        enableFullBright()
    else
        disableFullBright()
    end
end

-- Criar notificação
local Notifier = FiveSync.newNotify()


-- Criar seção
local VisualSection = WorldTab:DrawSection({
    Name = "Configurações Visuais",
    Position = 'left'
})

-- TOGGLE DO FULLBRIGHT
VisualSection:AddToggle({
    Name = "FullBright",
    Description = "Ativa/Desativa o brilho máximo no jogo",
    Default = false,
    Callback = function(enabled)
        toggleFullBright(enabled)
        
        -- Notificação de status
        Notifier.new({
            Title = "FullBright",
            Content = enabled and "✓ FullBright ATIVADO" or "✗ FullBright DESATIVADO",
            Duration = 2,
            Icon = "rbxassetid://95629194286677"
        })
    end
})

-- Informação adicional
VisualSection:AddParagraph({
    Title = "Info",
    Content = "FullBright ativo: Mantém a iluminação no máximo\nDesativo: Restaura as configurações originais"
})

-- Botão para resetar manualmente (caso necessário)
VisualSection:AddButton({
    Name = "Resetar Luzes (Manual)",
    Callback = function()
        if fullBrightActive then
            toggleFullBright(false)
            Notifier.new({
                Title = "FullBright",
                Content = "Iluminação resetada para o padrão",
                Duration = 2,
                Icon = "rbxassetid://95629194286677"
            })
        else
            disableFullBright()
            Notifier.new({
                Title = "FullBright",
                Content = "Configurações originais restauradas",
                Duration = 2,
                Icon = "rbxassetid://95629194286677"
            })
        end
    end
})

