        Order = 0,
    }

    local function SaveLayout()
        local out = { State = {
            Size = QuickState.Size,
            Transparency = QuickState.Transparency,
            ShowLabel = QuickState.ShowLabel,
            Accent = { R = QuickState.Accent.R, G = QuickState.Accent.G, B = QuickState.Accent.B },
        }, Buttons = {} }
        for id, b in pairs(QuickButtons.Registry) do
            out.Buttons[id] = {
                Visible = b.Frame.Visible,
                Pos = { b.Pos.X.Scale, b.Pos.X.Offset, b.Pos.Y.Scale, b.Pos.Y.Offset },
            }
        end
        pcall(function()
            if not isfolder("E$34x") then makefolder("E$34x") end
            writefile(LAYOUT_PATH, HttpService:JSONEncode(out))
        end)
    end

    local function LoadLayout()
        local ok, data = pcall(function()
            if isfile(LAYOUT_PATH) then
                return HttpService:JSONDecode(readfile(LAYOUT_PATH))
            end
            return nil
        end)
        if ok and type(data) == "table" then
            if type(data.State) == "table" then
                QuickState.Size = data.State.Size or QuickState.Size
                QuickState.Transparency = data.State.Transparency or QuickState.Transparency
                if data.State.ShowLabel ~= nil then QuickState.ShowLabel = data.State.ShowLabel end
                if data.State.Accent then
                    QuickState.Accent = Color3.new(data.State.Accent.R, data.State.Accent.G, data.State.Accent.B)
                end
            end
            return data.Buttons
        end
        return nil
    end
    local function EnsureRoot()
        if QuickButtons.Root and QuickButtons.Root.Parent then return QuickButtons.Root end
        local gui = Instance.new("ScreenGui")
        gui.Name = "E$34x_QuickButtons"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
        gui.DisplayOrder = 9999
        gui.Parent = QuickCoreGui
        QuickButtons.Root = gui
        return gui
    end

    -- Repintar o botao custa cinco escritas de propriedade. O poll de 0.25s
    -- chamava isso em todos os botoes visiveis mesmo sem nada mudar, entao cada
    -- entrada guarda a assinatura do que esta pintado e so repinta se mudou.
    local function Paint(entry, key, paint)
        if entry.__paintKey == key then return end
        entry.__paintKey = key
        paint()
    end

    -- Botão de ação (não reflete um Flag): só dispara a Callback ao clicar.
    local function RefreshVisualAction(entry)
        Paint(entry, "action:" .. QuickState.Accent:ToHex(), function()
            entry.Frame.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
            entry.Frame.BackgroundTransparency = 0.4
            entry.Stroke.Color = QuickState.Accent
            entry.Stroke.Transparency = 0.2
            entry.Label.TextColor3 = Color3.fromRGB(230, 230, 230)
        end)
    end

    -- Atualiza o visual (ligado/desligado) a partir do Flag alvo.
    local function RefreshVisual(entry)
        if entry.Def.Action then
            RefreshVisualAction(entry)
            return
        end
        local el = FiveSync.Flags[entry.Def.Flag]
        local on = false
        if el then
            local ok, v = pcall(function() return el:GetValue() end)
            on = ok and v == true
        end
        entry.On = on
        local key = (on and "1" or "0")
            .. ":" .. QuickState.Accent:ToHex()
            .. ":" .. tostring(QuickState.Transparency)
        Paint(entry, key, function()
            entry.Frame.BackgroundColor3 = on and QuickState.Accent or Color3.fromRGB(70, 70, 70)
            entry.Frame.BackgroundTransparency = on and QuickState.Transparency or 0.4
            entry.Stroke.Color = on and QuickState.Accent or Color3.fromRGB(90, 90, 90)
            entry.Stroke.Transparency = on and 0 or 0.4
            entry.Label.TextColor3 = on and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(230, 230, 230)
        end)
    end

    -- Alterna a função clicando no Flag correspondente do menu.
    local function ToggleEntry(entry)
        local el = FiveSync.Flags[entry.Def.Flag]
        if not el then return end
        local cur = el:GetValue()
        el:SetValue(not cur)
        FiveSync:_PlaySound(cur and "ToggleOff" or "ToggleOn")
        RefreshVisual(entry)
    end

    -- Ação de um toque (ex.: adicionar alvo da mira à whitelist).
    local function RunAction(entry)
        if entry.Def.Action then entry.Def.Action() end
        FiveSync:_PlaySound("ToggleOn")
        RefreshVisualAction(entry)
    end

    function QuickButtons.Create(def, saved)
        local root = EnsureRoot()
        local size = QuickState.Size

        local frame = Instance.new("Frame")
        frame.Name = "QB_" .. def.Id
        frame.Size = UDim2.fromOffset(size * 2.1, size)
        frame.Position = UDim2.fromOffset(20, 20 + QuickButtons.Order * (size + 8))
        frame.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        frame.BackgroundTransparency = 0.4
        frame.BorderSizePixel = 0
        frame.Visible = def.DefaultVisible == true
        frame.Parent = root

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(90, 90, 90)
        stroke.Thickness = 1
        stroke.Transparency = 0.4
        stroke.Parent = frame

        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.Text = QuickState.ShowLabel and def.Label or ""
        label.TextSize = 13
        label.TextColor3 = Color3.fromRGB(230, 230, 230)
        label.TextTransparency = 0
        label.Parent = frame

        local entry = {
            Def = def,
            Frame = frame,
            Stroke = stroke,
            Label = label,
            Pos = frame.Position,
            On = false,
            DidDrag = false,
            IsAction = def.Action ~= nil,
        }

        if saved then
            if saved.Visible ~= nil then
                frame.Visible = saved.Visible == true
            end
            if type(saved.Pos) == "table" then
                entry.Pos = UDim2.new(saved.Pos[1] or 0, saved.Pos[2] or 0, saved.Pos[3] or 0, saved.Pos[4] or 0)
                frame.Position = entry.Pos
            end
        end

        local click = Instance.new("TextButton")
        click.Name = "Click"
        click.Size = UDim2.fromScale(1, 1)
        click.BackgroundTransparency = 1
        click.Text = ""
        click.ZIndex = frame.ZIndex + 1
        click.Parent = frame

        -- Um clique curto alterna a função; manter pressionado por >= HOLD
        -- segundos (ou mover o mouse) inicia o arraste do botão.
        local HOLD = 3
        local dragStart, startPos, dragArmed, dragging, downAt
        local function StopDrag()
            if dragging then SaveLayout() end
            dragStart, dragArmed, dragging, downAt = nil, false, false, nil
        end
        click.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragStart = input.Position
                startPos = frame.Position
                downAt = os.clock()
                dragArmed, dragging = false, false
                entry.DidDrag = false
            end
        end)
        click.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local wasDrag = entry.DidDrag
                StopDrag()
                if not wasDrag then
                    if entry.Def.Action then RunAction(entry) else ToggleEntry(entry) end
                end
            end
        end)
        QuickUIS.InputChanged:Connect(function(input)
            if not dragStart then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                local moved = math.abs(delta.X) > 6 or math.abs(delta.Y) > 6
                if (downAt and os.clock() - downAt >= HOLD) or moved then dragArmed = true end
                if dragArmed then
                    dragging = true
                    entry.DidDrag = true
                    entry.Pos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                    frame.Position = entry.Pos
                end
            end
        end)
        QuickUIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if dragStart then StopDrag() end
            end
        end)

        entry.Click = click

        QuickButtons.Order = QuickButtons.Order + 1
        QuickButtons.Registry[def.Id] = entry
        RefreshVisual(entry)
        return entry
    end

    function QuickButtons.ApplyStyle()
        for _, entry in pairs(QuickButtons.Registry) do
            entry.Frame.Size = UDim2.fromOffset(QuickState.Size * 2.1, QuickState.Size)
            entry.Label.Text = QuickState.ShowLabel and entry.Def.Label or ""
            RefreshVisual(entry)
        end
        SaveLayout()
    end

    local saved = LoadLayout()

    -- Seção: quais botões aparecem na tela (cada um é um Flag do menu).
    local QuickListSection = ButtonTab:DrawSection({ Name = "Botões na Tela", Position = "left" })
    for _, def in ipairs(QuickDefs) do
        QuickButtons.Create(def, saved and saved[def.Id])
        local entry = QuickButtons.Registry[def.Id]
        QuickListSection:AddToggle({
            Flag = "QuickBtn_" .. def.Id,
            Name = def.Label,
            Default = entry.Frame.Visible,
            Callback = function(v)
                entry.Frame.Visible = v
                if v then RefreshVisual(entry) end
                SaveLayout()
            end
        })
    end

    -- Seção: aparência e layout.
    local QuickCfgSection = ButtonTab:DrawSection({ Name = "Aparência", Position = "right" })
    QuickCfgSection:AddSlider({
        Flag = "QuickBtn_Tamanho", Name = "Tamanho", Min = 24, Max = 64, Default = QuickState.Size,
        Callback = function(v) QuickState.Size = math.floor(v); QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddSlider({
        Flag = "QuickBtn_Transparencia", Name = "Transparência (ligado)", Min = 0, Max = 0.8, Round = 2, Default = QuickState.Transparency,
        Callback = function(v) QuickState.Transparency = v; QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddColorPicker({
        Flag = "QuickBtn_Cor", Name = "Cor de Destaque", Default = QuickState.Accent,
        Callback = function(c) QuickState.Accent = c; QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddToggle({
        Flag = "QuickBtn_MostrarRotulo", Name = "Mostrar Rótulo", Default = QuickState.ShowLabel,
        Callback = function(v) QuickState.ShowLabel = v; QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddButton({ Name = "Resetar Posições", Callback = function()
        local i = 0
        for _, entry in pairs(QuickButtons.Registry) do
            entry.Pos = UDim2.fromOffset(20, 20 + i * (QuickState.Size + 8))
            entry.Frame.Position = entry.Pos
            i = i + 1
        end
        SaveLayout()
    end })
    QuickCfgSection:AddButton({ Name = "Mostrar Todos", Callback = function()
        for _, def in ipairs(QuickDefs) do
            local el = FiveSync.Flags["QuickBtn_" .. def.Id]
            if el then el:SetValue(true) end
        end
    end })
    QuickCfgSection:AddButton({ Name = "Ocultar Todos", Callback = function()
        for _, def in ipairs(QuickDefs) do
            local el = FiveSync.Flags["QuickBtn_" .. def.Id]
            if el then el:SetValue(false) end
        end
    end })

    -- Mantém o visual sincronizado quando a função muda por outro caminho.
    task.spawn(function()
        while true do
            task.wait(0.25)
            for _, entry in pairs(QuickButtons.Registry) do
                if entry.Frame.Visible then RefreshVisual(entry) end
            end
        end
    end)

    -- Exposto para depuração/uso externo.
    getgenv().E34x_QuickButtons = QuickButtons
end


