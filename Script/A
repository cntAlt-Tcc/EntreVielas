--========================
-- VARIÁVEIS
--========================
local ThirdEnabled = false
local MaxZoom = 999

local CameraConn

--========================
-- NOTIFY
--========================
local function NotifyCam(txt)
    Notifier.new({
        Title = "Câmera",
        Content = txt,
        Duration = 1.5,
        Icon = "rbxassetid://117056629401480"
    })
end

--========================
-- APLICAR CONFIG
--========================
local function ApplyCamera()
    local plr = Players.LocalPlayer

    plr.CameraMode = Enum.CameraMode.Classic
    plr.CameraMaxZoomDistance = MaxZoom

    -- opcional (evita travar muito perto)
    if plr.CameraMinZoomDistance < 5 then
        plr.CameraMinZoomDistance = 5
    end
end

--========================
-- LOOP ANTI RESET
--========================
local function StartCameraLoop()
    if CameraConn then return end

    CameraConn = RunService.RenderStepped:Connect(function()
        if not ThirdEnabled then return end
        ApplyCamera()
    end)
end

local function StopCameraLoop()
    if CameraConn then
        CameraConn:Disconnect()
        CameraConn = nil
    end
end

--========================
-- TOGGLE
--========================
local function ToggleThird(state)
    ThirdEnabled = state

    if state then
        ApplyCamera()
        StartCameraLoop()
        NotifyCam("3ª Pessoa Ativada")
    else
        StopCameraLoop()
        NotifyCam("Desativado")
    end
end

--========================
-- RESPAWN FIX
--========================
Player.CharacterAdded:Connect(function()
    task.wait(0.2)
    if ThirdEnabled then
        ApplyCamera()
    end
end)

CameraSection:AddToggle({
    Name = "Forçar 3ª Pessoa",
    Default = false,
    Flag = "Camera_ThirdPerson",
    Callback = ToggleThird
})

local NotifyCamDebounced = FiveSync:Debounce(0.25, function(v)
    NotifyCam("Zoom: "..tostring(v))
end)

CameraSection:AddSlider({
    Name = "Distância Máxima",
    Default = MaxZoom,
    Min = 50,
    Max = 2000,
    Flag = "Camera_MaxZoom",
    Callback = function(v)
        MaxZoom = math.floor(v)
        if ThirdEnabled then
            ApplyCamera()
        end
        NotifyCamDebounced(MaxZoom)
    end
})

-- ==============================================================
-- Seção Motion Blur (aba Mundo) - desfoque dinâmico pela velocidade da câmera
-- ==============================================================
local MotionBlurSection = WorldTab:DrawSection({
    Name = "Motion Blur",
    Position = "left"
})

local MB_Camera = workspace.CurrentCamera
local MB_Amount = 15        --Select your amount--
local MB_Amplifier = 5      --If you know yk--
local MB_Last = MB_Camera and MB_Camera.CFrame.LookVector or nil
local MB_Effect = nil
local MB_Enabled = false
local MB_Connection = nil

local function MB_Ensure()
    if not MB_Camera then return nil end
    if not MB_Effect or not MB_Effect.Parent then
        MB_Effect = Instance.new("BlurEffect", MB_Camera)
        MB_Effect.Name = "E34x_MotionBlur"
    end
    return MB_Effect
end

local function MB_Update()
    if not MB_Enabled or not MB_Camera or not MB_Last then return end
    local blur = MB_Ensure()
    if not blur then return end
    local magnitude = (MB_Camera.CFrame.LookVector - MB_Last).Magnitude
    blur.Size = math.clamp(math.abs(magnitude) * MB_Amount * MB_Amplifier / 2, 0, 56)
    MB_Last = MB_Camera.CFrame.LookVector
end

local function MB_SetState(state)
    MB_Enabled = state
    if state then
        if MB_Camera then MB_Last = MB_Camera.CFrame.LookVector end
        MB_Ensure()
        if not MB_Connection then
            MB_Connection = RunService.Heartbeat:Connect(MB_Update)
        end
    else
        if MB_Connection then
            MB_Connection:Disconnect()
            MB_Connection = nil
        end
        if MB_Effect then
            MB_Effect:Destroy()
            MB_Effect = nil
        end
    end
end

workspace.Changed:Connect(function(property)
    if property == "CurrentCamera" then
        MB_Camera = workspace.CurrentCamera
        MB_Last = MB_Camera and MB_Camera.CFrame.LookVector or nil
        if MB_Effect then MB_Effect:Destroy(); MB_Effect = nil end
        if MB_Enabled then MB_Ensure() end
    end
end)

MotionBlurSection:AddParagraph({
    Title = "Motion Blur",
    Content = "Desfoque dinâmico baseado na velocidade de rotação da câmera."
})

MotionBlurSection:AddToggle({
    Name = "Ativar Motion Blur",
    Default = false,
    Flag = "Visual_MotionBlur",
    Callback = function(v)
        MB_SetState(v)
        Notifier.new({
            Title = "Motion Blur",
            Content = v and "Ativado" or "Desativado",
            Duration = 1.5,
            Icon = "rbxassetid://117056629401480"
        })
    end
})

MotionBlurSection:AddSlider({
    Name = "Intensidade",
    Min = 0,
    Max = 100,
    Default = MB_Amount,
    Flag = "Visual_MotionBlurAmount",
    Callback = function(v) MB_Amount = v end
})

MotionBlurSection:AddSlider({
    Name = "Amplificador",
    Min = 1,
    Max = 20,
    Default = MB_Amplifier,
    Flag = "Visual_MotionBlurAmp",
    Callback = function(v) MB_Amplifier = v end
})


-- ==============================================================
-- Aba "Botões": HUD de botões on-screen para ligar/desligar funções.
-- Cada botão espelha o estado de um Flag do menu; clicar alterna o Flag.
-- Layout (visibilidade + posição) é salvo em disco e recarregado no start.
-- ==============================================================
local ButtonTab = VisualContainer:DrawTab({
    Name = " Botões ",
    Type = "Single",
    EnableScrolling = true,
});

do
    local HttpService = game:GetService("HttpService")
    local QuickUIS = game:GetService("UserInputService")
    local QuickCoreGui = (gethui and gethui()) or game:GetService("CoreGui")
    local LAYOUT_PATH = "E$34x/QuickButtons.json"

    local QuickState = {
        Size = 36,
        Transparency = 0.15,
        Accent = Color3.fromRGB(255, 255, 255),
        ShowLabel = true,
    }

    local QuickDefs = {
        { Id = "Speed",      Flag = "Movement_EnableSpeed",     Label = "SPEED" },
        { Id = "Fly",        Flag = "Movement_Fly",             Label = "FLY" },
        { Id = "SkyBase",    Flag = "Movement_SkyBase",         Label = "SKY" },
        { Id = "Noclip",     Flag = "Movement_Noclip",          Label = "NOCLIP" },
        { Id = "BunnyHop",   Flag = "BunnyHop",                 Label = "BUNNY" },
        { Id = "InfJump",    Flag = "InfiniteJump",             Label = "INFJUMP" },
        { Id = "Aimbot",     Flag = "Section_AtivarAimbot",     Label = "AIM" },
        { Id = "SilentAim",  Flag = "SAConfig_AtivarSilentAim", Label = "SILENT" },
        { Id = "Hitbox",     Flag = "Combat_HitboxEnabled",     Label = "HITBOX" },
        { Id = "ESP",        Flag = "SecMain_AtivarESP",        Label = "ESP" },
        { Id = "FullBright", Flag = "VisualSection_FullBright", Label = "LIGHT" },
        { Id = "AddWL",      Label = "ADD WL", Action = function()
            if getgenv().E34x_AddAimTargetToWhitelist then getgenv().E34x_AddAimTargetToWhitelist() end
        end },
    }

    local QuickButtons = {
        Root = nil,
        Registry = {},
        Order = 0,
    }

    local function SaveLayout()
        local out = { State = {
            Size = QuickState.Size,
            Transparency = QuickState.Transparency,
            ShowLabel = QuickState.ShowLabel,
            Accent = { R = QuickState.Accent.R, G = QuickState.Accent.G, B = QuickState.Accent.B },
        }, Buttons = {} }
        for id, b in pairs(QuickButtons.Registry) do
            out.Buttons[id] = {
                Visible = b.Frame.Visible,
                Pos = { b.Pos.X.Scale, b.Pos.X.Offset, b.Pos.Y.Scale, b.Pos.Y.Offset },
            }
        end
        pcall(function()
            if not isfolder("E$34x") then makefolder("E$34x") end
            writefile(LAYOUT_PATH, HttpService:JSONEncode(out))
        end)
    end

    local function LoadLayout()
        local ok, data = pcall(function()
            if isfile(LAYOUT_PATH) then
                return HttpService:JSONDecode(readfile(LAYOUT_PATH))
            end
            return nil
        end)
        if ok and type(data) == "table" then
            if type(data.State) == "table" then
                QuickState.Size = data.State.Size or QuickState.Size
                QuickState.Transparency = data.State.Transparency or QuickState.Transparency
                if data.State.ShowLabel ~= nil then QuickState.ShowLabel = data.State.ShowLabel end
                if data.State.Accent then
                    QuickState.Accent = Color3.new(data.State.Accent.R, data.State.Accent.G, data.State.Accent.B)
                end
            end
            return data.Buttons
        end
        return nil
    end
    local function EnsureRoot()
        if QuickButtons.Root and QuickButtons.Root.Parent then return QuickButtons.Root end
        local gui = Instance.new("ScreenGui")
        gui.Name = "E$34x_QuickButtons"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
        gui.DisplayOrder = 9999
        gui.Parent = QuickCoreGui
        QuickButtons.Root = gui
        return gui
    end

    -- Botão de ação (não reflete um Flag): só dispara a Callback ao clicar.
    local function RefreshVisualAction(entry)
        entry.Frame.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        entry.Frame.BackgroundTransparency = 0.4
        entry.Stroke.Color = QuickState.Accent
        entry.Stroke.Transparency = 0.2
        entry.Label.TextColor3 = Color3.fromRGB(230, 230, 230)
    end

    -- Atualiza o visual (ligado/desligado) a partir do Flag alvo.
    local function RefreshVisual(entry)
        if entry.Def.Action then
            RefreshVisualAction(entry)
            return
        end
        local el = FiveSync.Flags[entry.Def.Flag]
        local on = false
        if el then
            local ok, v = pcall(function() return el:GetValue() end)
            on = ok and v == true
        end
        entry.On = on
        local col = on and QuickState.Accent or Color3.fromRGB(70, 70, 70)
        entry.Frame.BackgroundColor3 = col
        entry.Frame.BackgroundTransparency = on and QuickState.Transparency or 0.4
        entry.Stroke.Color = on and QuickState.Accent or Color3.fromRGB(90, 90, 90)
        entry.Stroke.Transparency = on and 0 or 0.4
        entry.Label.TextColor3 = on and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(230, 230, 230)
    end

    -- Alterna a função clicando no Flag correspondente do menu.
    local function ToggleEntry(entry)
        local el = FiveSync.Flags[entry.Def.Flag]
        if not el then return end
        local cur = el:GetValue()
        el:SetValue(not cur)
        FiveSync:_PlaySound(cur and "ToggleOff" or "ToggleOn")
        RefreshVisual(entry)
    end

    -- Ação de um toque (ex.: adicionar alvo da mira à whitelist).
    local function RunAction(entry)
        if entry.Def.Action then entry.Def.Action() end
        FiveSync:_PlaySound("ToggleOn")
        RefreshVisualAction(entry)
    end

    function QuickButtons.Create(def, saved)
        local root = EnsureRoot()
        local size = QuickState.Size

        local frame = Instance.new("Frame")
        frame.Name = "QB_" .. def.Id
        frame.Size = UDim2.fromOffset(size * 2.1, size)
        frame.Position = UDim2.fromOffset(20, 20 + QuickButtons.Order * (size + 8))
        frame.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
        frame.BackgroundTransparency = 0.4
        frame.BorderSizePixel = 0
        frame.Visible = false
        frame.Parent = root

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(90, 90, 90)
        stroke.Thickness = 1
        stroke.Transparency = 0.4
        stroke.Parent = frame

        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.Text = QuickState.ShowLabel and def.Label or ""
        label.TextSize = 13
        label.TextColor3 = Color3.fromRGB(230, 230, 230)
        label.TextTransparency = 0
        label.Parent = frame

        local entry = {
            Def = def,
            Frame = frame,
            Stroke = stroke,
            Label = label,
            Pos = frame.Position,
            On = false,
            DidDrag = false,
            IsAction = def.Action ~= nil,
        }

        if saved then
            frame.Visible = saved.Visible == true
            if type(saved.Pos) == "table" then
                entry.Pos = UDim2.new(saved.Pos[1] or 0, saved.Pos[2] or 0, saved.Pos[3] or 0, saved.Pos[4] or 0)
                frame.Position = entry.Pos
            end
        end

        local click = Instance.new("TextButton")
        click.Name = "Click"
        click.Size = UDim2.fromScale(1, 1)
        click.BackgroundTransparency = 1
        click.Text = ""
        click.ZIndex = frame.ZIndex + 1
        click.Parent = frame

        -- Um clique curto alterna a função; manter pressionado por >= HOLD
        -- segundos (ou mover o mouse) inicia o arraste do botão.
        local HOLD = 3
        local dragStart, startPos, dragArmed, dragging, downAt
        local function StopDrag()
            if dragging then SaveLayout() end
            dragStart, dragArmed, dragging, downAt = nil, false, false, nil
        end
        click.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragStart = input.Position
                startPos = frame.Position
                downAt = os.clock()
                dragArmed, dragging = false, false
                entry.DidDrag = false
            end
        end)
        click.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local wasDrag = entry.DidDrag
                StopDrag()
                if not wasDrag then
                    if entry.Def.Action then RunAction(entry) else ToggleEntry(entry) end
                end
            end
        end)
        QuickUIS.InputChanged:Connect(function(input)
            if not dragStart then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStart
                local moved = math.abs(delta.X) > 6 or math.abs(delta.Y) > 6
                if (downAt and os.clock() - downAt >= HOLD) or moved then dragArmed = true end
                if dragArmed then
                    dragging = true
                    entry.DidDrag = true
                    entry.Pos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                    frame.Position = entry.Pos
                end
            end
        end)
        QuickUIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if dragStart then StopDrag() end
            end
        end)

        entry.Click = click

        QuickButtons.Order = QuickButtons.Order + 1
        QuickButtons.Registry[def.Id] = entry
        RefreshVisual(entry)
        return entry
    end

    function QuickButtons.ApplyStyle()
        for _, entry in pairs(QuickButtons.Registry) do
            entry.Frame.Size = UDim2.fromOffset(QuickState.Size * 2.1, QuickState.Size)
            entry.Label.Text = QuickState.ShowLabel and entry.Def.Label or ""
            RefreshVisual(entry)
        end
        SaveLayout()
    end

    local saved = LoadLayout()

    -- Seção: quais botões aparecem na tela (cada um é um Flag do menu).
    local QuickListSection = ButtonTab:DrawSection({ Name = "Botões na Tela", Position = "left" })
    for _, def in ipairs(QuickDefs) do
        QuickButtons.Create(def, saved and saved[def.Id])
        local entry = QuickButtons.Registry[def.Id]
        QuickListSection:AddToggle({
            Flag = "QuickBtn_" .. def.Id,
            Name = def.Label,
            Default = entry.Frame.Visible,
            Callback = function(v)
                entry.Frame.Visible = v
                if v then RefreshVisual(entry) end
                SaveLayout()
            end
        })
    end

    -- Seção: aparência e layout.
    local QuickCfgSection = ButtonTab:DrawSection({ Name = "Aparência", Position = "right" })
    QuickCfgSection:AddSlider({
        Flag = "QuickBtn_Tamanho", Name = "Tamanho", Min = 24, Max = 64, Default = QuickState.Size,
        Callback = function(v) QuickState.Size = math.floor(v); QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddSlider({
        Flag = "QuickBtn_Transparencia", Name = "Transparência (ligado)", Min = 0, Max = 0.8, Round = 2, Default = QuickState.Transparency,
        Callback = function(v) QuickState.Transparency = v; QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddColorPicker({
        Flag = "QuickBtn_Cor", Name = "Cor de Destaque", Default = QuickState.Accent,
        Callback = function(c) QuickState.Accent = c; QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddToggle({
        Flag = "QuickBtn_MostrarRotulo", Name = "Mostrar Rótulo", Default = QuickState.ShowLabel,
        Callback = function(v) QuickState.ShowLabel = v; QuickButtons.ApplyStyle() end
    })
    QuickCfgSection:AddButton({ Name = "Resetar Posições", Callback = function()
        local i = 0
        for _, entry in pairs(QuickButtons.Registry) do
            entry.Pos = UDim2.fromOffset(20, 20 + i * (QuickState.Size + 8))
            entry.Frame.Position = entry.Pos
            i = i + 1
        end
        SaveLayout()
    end })
    QuickCfgSection:AddButton({ Name = "Mostrar Todos", Callback = function()
        for _, def in ipairs(QuickDefs) do
            local el = FiveSync.Flags["QuickBtn_" .. def.Id]
            if el then el:SetValue(true) end
        end
    end })
    QuickCfgSection:AddButton({ Name = "Ocultar Todos", Callback = function()
        for _, def in ipairs(QuickDefs) do
            local el = FiveSync.Flags["QuickBtn_" .. def.Id]
            if el then el:SetValue(false) end
        end
    end })

    -- Mantém o visual sincronizado quando a função muda por outro caminho.
    task.spawn(function()
        while true do
            task.wait(0.25)
            for _, entry in pairs(QuickButtons.Registry) do
                if entry.Frame.Visible then RefreshVisual(entry) end
            end
        end
    end)

    -- Exposto para depuração/uso externo.
    getgenv().E34x_QuickButtons = QuickButtons
end


