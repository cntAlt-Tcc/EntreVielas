local LocalPlayer = Players.LocalPlayer or Players.LocalPlayerAdded:Wait()
local Camera = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")


-- // Configurações Globais
getgenv().Aimbot_Ativo = false
getgenv().Aimbot_Metodo = "Humanizado"
getgenv().Aimbot_FOV = 150
getgenv().Aimbot_Forca = 50
getgenv().Aimbot_TargetPart = "Head"
getgenv().Aimbot_WallCheck = false
getgenv().Aimbot_TeamCheck = false
getgenv().Aimbot_IgnoreFriends = false
getgenv().Aimbot_ItemCheck = false -- Se ligado, aimbot só funciona se VOCÊ segurar um item
getgenv().Aimbot_Whitelist = {}
getgenv().Aimbot_FOVColor = Color3.fromRGB(255, 255, 255)
getgenv().Aimbot_FOVRGB = false
getgenv().Aimbot_FOVTransparency = 0.5
getgenv().Aimbot_FOVStyle = "Círculo" -- "Círculo", "Quadrado", "Traçado", "Animado", "Nenhum"

-- // FOV na Tela
local FOVGui = Instance.new("ScreenGui")
FOVGui.Name = "FOV_Display_v10"
FOVGui.IgnoreGuiInset = true
FOVGui.Parent = (gethui and gethui()) or game:GetService("CoreGui")

local FOVFrame = Instance.new("Frame")
FOVFrame.Name = "FOV_Visual"
FOVFrame.AnchorPoint = Vector2.new(0.5, 0.5)
FOVFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
FOVFrame.BackgroundTransparency = 1 -- Sempre transparente por dentro
FOVFrame.BorderSizePixel = 0
FOVFrame.Parent = FOVGui

