--========================
-- VARIÁVEIS
--========================
local ThirdEnabled = false
local MaxZoom = 999

local CameraConn

--========================
-- NOTIFY
--========================
local function NotifyCam(txt)
    Notifier.new({
        Title = "Câmera",
        Content = txt,
        Duration = 1.5,
        Icon = "rbxassetid://117056629401480"
    })
end

--========================
-- APLICAR CONFIG
--========================
local function ApplyCamera()
    local plr = Players.LocalPlayer

    -- Roda por frame porque o jogo reseta esses valores; escrever so quando
    -- diferem evita que cada frame dispare a replicacao de propriedades.
    if plr.CameraMode ~= Enum.CameraMode.Classic then
        plr.CameraMode = Enum.CameraMode.Classic
    end

    if plr.CameraMaxZoomDistance ~= MaxZoom then
        plr.CameraMaxZoomDistance = MaxZoom
    end

    -- opcional (evita travar muito perto)
    if plr.CameraMinZoomDistance < 5 then
        plr.CameraMinZoomDistance = 5
    end
end

--========================
-- LOOP ANTI RESET
--========================
local function StartCameraLoop()
    if CameraConn then return end

    CameraConn = RunService.RenderStepped:Connect(function()
        if not ThirdEnabled then return end
        ApplyCamera()
    end)
end

local function StopCameraLoop()
    if CameraConn then
        CameraConn:Disconnect()
        CameraConn = nil
    end
end

--========================
-- TOGGLE
--========================
local function ToggleThird(state)
    ThirdEnabled = state

    if state then
        ApplyCamera()
        StartCameraLoop()
        NotifyCam("3ª Pessoa Ativada")
    else
        StopCameraLoop()
        NotifyCam("Desativado")
    end
end

--========================
-- RESPAWN FIX
--========================
Player.CharacterAdded:Connect(function()
    task.wait(0.2)
    if ThirdEnabled then
        ApplyCamera()
    end
end)

CameraSection:AddToggle({
    Name = "Forçar 3ª Pessoa",
    Default = false,
    Flag = "Camera_ThirdPerson",
    Callback = ToggleThird
})

local NotifyCamDebounced = FiveSync:Debounce(0.25, function(v)
    NotifyCam("Zoom: "..tostring(v))
end)

CameraSection:AddSlider({
    Name = "Distância Máxima",
    Default = MaxZoom,
    Min = 50,
    Max = 2000,
    Flag = "Camera_MaxZoom",
    Callback = function(v)
        MaxZoom = math.floor(v)
        if ThirdEnabled then
            ApplyCamera()
        end
        NotifyCamDebounced(MaxZoom)
    end
})

-- ==============================================================
-- Seção Motion Blur (aba Mundo) - desfoque dinâmico pela velocidade da câmera
-- ==============================================================
local MotionBlurSection = WorldTab:DrawSection({
    Name = "Motion Blur",
    Position = "left"
})

local MB_Camera = workspace.CurrentCamera
local MB_Amount = 15        --Select your amount--
local MB_Amplifier = 5      --If you know yk--
local MB_Last = MB_Camera and MB_Camera.CFrame.LookVector or nil
local MB_Effect = nil
local MB_Enabled = false
local MB_Connection = nil

local function MB_Ensure()
    if not MB_Camera then return nil end
    if not MB_Effect or not MB_Effect.Parent then
        MB_Effect = Instance.new("BlurEffect", MB_Camera)
        MB_Effect.Name = "E34x_MotionBlur"
    end
    return MB_Effect
end

local function MB_Update()
    if not MB_Enabled or not MB_Camera or not MB_Last then return end
    local blur = MB_Ensure()
    if not blur then return end
    local magnitude = (MB_Camera.CFrame.LookVector - MB_Last).Magnitude
    blur.Size = math.clamp(math.abs(magnitude) * MB_Amount * MB_Amplifier / 2, 0, 56)
    MB_Last = MB_Camera.CFrame.LookVector
end

local function MB_SetState(state)
    MB_Enabled = state
    if state then
        if MB_Camera then MB_Last = MB_Camera.CFrame.LookVector end
        MB_Ensure()
        if not MB_Connection then
            MB_Connection = RunService.Heartbeat:Connect(MB_Update)
        end
    else
        if MB_Connection then
            MB_Connection:Disconnect()
            MB_Connection = nil
        end
        if MB_Effect then
            MB_Effect:Destroy()
            MB_Effect = nil
        end
    end
end

workspace.Changed:Connect(function(property)
    if property == "CurrentCamera" then
        MB_Camera = workspace.CurrentCamera
        MB_Last = MB_Camera and MB_Camera.CFrame.LookVector or nil
        if MB_Effect then MB_Effect:Destroy(); MB_Effect = nil end
        if MB_Enabled then MB_Ensure() end
    end
end)

MotionBlurSection:AddParagraph({
    Title = "Motion Blur",
    Content = "Desfoque dinâmico baseado na velocidade de rotação da câmera."
})

MotionBlurSection:AddToggle({
    Name = "Ativar Motion Blur",
    Default = false,
    Flag = "Visual_MotionBlur",
    Callback = function(v)
        MB_SetState(v)
        Notifier.new({
            Title = "Motion Blur",
            Content = v and "Ativado" or "Desativado",
            Duration = 1.5,
            Icon = "rbxassetid://117056629401480"
        })
    end
})

MotionBlurSection:AddSlider({
    Name = "Intensidade",
    Min = 0,
    Max = 100,
    Default = MB_Amount,
    Flag = "Visual_MotionBlurAmount",
    Callback = function(v) MB_Amount = v end
})

MotionBlurSection:AddSlider({
    Name = "Amplificador",
    Min = 1,
    Max = 20,
    Default = MB_Amplifier,
    Flag = "Visual_MotionBlurAmp",
    Callback = function(v) MB_Amplifier = v end
})


