-- [[ SCRIPT DE LOG E BAN CHECK COMPLETO ]]
-- [[ INTEGRAÇÃO COM API: http://bot.cyerox.fun:3021 ]]
-- =====================================================
-- PROTEÇÃO DE SCRIPT – COLAR NO TOPO DO SCRIPT ALVO
-- =====================================================

if not _G.LoaderExecutedByLoader then
	game:GetService("Players").LocalPlayer:Kick("use o loader")
	return
end

local key = _G.LoaderKey
local apiUrl = _G.LoaderApiUrl or "http://bot.cyerox.fun:3021"

if not key then
	game:GetService("Players").LocalPlayer:Kick("Key não fornecida pelo loader")
	return
end

local function validateKey()
	local url = apiUrl .. "/api/key/validate/" .. key
	local request = syn and syn.request or request or (http and http.request)
	
	if not request then
		warn("No HTTP request function")
		return false
	end
	
	local success, response = pcall(function()
		return request({
			Url = url,
			Method = "GET",
			Headers = {["Content-Type"] = "application/json"}
		})
	end)
	
	if not success then
		warn("Request failed")
		return false
	end
	
	local data = game:GetService("HttpService"):JSONDecode(response.Body)
	
	if data.valid then
		local keyInfo = data.key
		local expiresAt = keyInfo.expires_at
		local now = os.time()
		local remaining = expiresAt and (expiresAt - now) or nil
		
		local remainingStr = "Permanent"
		if remaining and remaining > 0 then
			local days = math.floor(remaining / 86400)
			local hours = math.floor((remaining % 86400) / 3600)
			local minutes = math.floor((remaining % 3600) / 60)
			local seconds = remaining % 60
			if days > 0 then
				remainingStr = string.format("%dd %dh", days, hours)
			elseif hours > 0 then
				remainingStr = string.format("%dh %dm", hours, minutes)
			elseif minutes > 0 then
				remainingStr = string.format("%dm %ds", minutes, seconds)
			else
				remainingStr = string.format("%ds", seconds)
			end
		end
		
		print("Key Válida")
		print("Tempo restante: " .. remainingStr)
		print("Api está em: " .. apiUrl)
		_G.LoaderExpireAt = expiresAt   -- guarda o timestamp unix
		return true
	else
		print("Key inválida ou expirada")
		return false
	end
end

if not validateKey() then
	game:GetService("Players").LocalPlayer:Kick("Key inválida/expirada. Use o loader para obter uma nova.")
	return
end

-- =====================================================
-- A PARTIR DAQUI VEM O SEU SCRIPT ALVO NORMAL
-- =====================================================
local API_URL = "http://bot.cyerox.fun:3021"
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Função para obter informações do sistema (HWID simulado no Roblox)
local function get_hwid()
    -- No Roblox, não há acesso direto ao HWID real, usamos o JobId ou uma combinação de dados
    return game:GetService("RbxAnalyticsService"):GetClientId()
end

-- Função para verificar Ban e registrar Log
local function check_and_log()
    local data = {
        jogo = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name,
        game_id = tostring(game.GameId),
        displaynick = LocalPlayer.DisplayName,
        nick = LocalPlayer.Name,
        id = tostring(LocalPlayer.UserId),
        executor = (identifyexecutor and identifyexecutor()) or "Desconhecido",
        place_id = tostring(game.PlaceId),
        job_id = tostring(game.JobId),
        version = "2.0.0",
        hwid = get_hwid()
    }

    local success, response = pcall(function()
        return HttpService:RequestAsync({
            Url = API_URL .. "/api/log",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(data)
        })
    end)

    if success then
        local resData = HttpService:JSONDecode(response.Body)
        if resData.status == "banido" then
            LocalPlayer:Kick("\n[E$34x Security]\n\nVocê está banido deste script.\nMotivo: " .. (resData.motivo or "Não especificado"))
            return false
        end
        print("[E$34x] Log registrado com sucesso!")
        return true
    else
        warn("[E$34x] Erro ao conectar com a API: " .. tostring(response))
        -- Opcional: Impedir execução se a API estiver offline
        -- LocalPlayer:Kick("Erro de conexão com o servidor de segurança.")
        return true
    end
end

-- Executa a verificação
if not check_and_log() then
    return -- Para a execução do script se estiver banido
end

