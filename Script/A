                Content = "Iluminação resetada para o padrão",
                Duration = 2,
                Icon = "rbxassetid://117056629401480"
            })
        else
            disableFullBright()
            Notifier.new({
                Title = "FullBright",
                Content = "Configurações originais restauradas",
                Duration = 2,
                Icon = "rbxassetid://117056629401480"
            })
        end
    end
})

