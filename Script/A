    Name = "Ativar Hitbox Expansiva",
    Default = false,
    Flag = "Combat_HitboxEnabled",
    Callback = function(state)
        toggleHitboxes(state)   -- sua função já existente
    end
})

-- Slider para definir o tamanho
HitboxConfigSection:AddSlider({
    Name = "Tamanho da Hitbox",
    Default = hitboxSize,       -- variável que você já declarou no início
    Min = 2,
    Max = 30,
    Round = 0,
    Flag = "Combat_HitboxSize",
    Callback = function(value)
        hitboxSize = math.floor(value)
        if hitboxEnabled then
            applyHitboxesToAllPlayers()
        end
    end
})

-- Slider para transparência
HitboxVisualSection:AddSlider({
    Name = "Transparência",
    Default = hitboxTransparency,
    Min = 0,
    Max = 1,
    Round = 2,
    Flag = "Combat_HitboxTransparency",
    Callback = function(value)
        hitboxTransparency = value
        if hitboxEnabled then
            applyHitboxesToAllPlayers()
        end
    end
})

-- Botão de reset manual
HitboxVisualSection:AddButton({
    Name = "Resetar Hitboxes",
    Callback = function()
        resetHitboxesOnAllPlayers()
        Notifier.new({
            Title = "Hitbox",
            Content = "Hitboxes resetadas!",
            Duration = 2,
            Icon = "rbxassetid://117056629401480"
        })
    end
})

-- Botões + e - (aparecem/desaparecem junto com o toggle)
hitboxIncreaseButton = HitboxButtonsSection:AddButton({
    Name = "+ Aumentar Tamanho",
    Callback = function()
        hitboxSize = math.min(hitboxSize + 1, 30)
        if hitboxEnabled then
            applyHitboxesToAllPlayers()
        end
    end
})

hitboxDecreaseButton = HitboxButtonsSection:AddButton({
    Name = "- Diminuir Tamanho",
    Callback = function()
        hitboxSize = math.max(hitboxSize - 1, 2)
        if hitboxEnabled then
            applyHitboxesToAllPlayers()
        end
    end
})

-- Visibilidade inicial (já que o toggle começa desligado)
hitboxIncreaseButton.Visible = false
hitboxDecreaseButton.Visible = false




