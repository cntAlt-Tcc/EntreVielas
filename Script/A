-- Exibe o tempo restante da key no rodapé (sem sobrecarregar a API)
local function formatRemaining(remaining)
    if remaining <= 0 then
        return "Expirada"
    elseif remaining >= 86400 * 365 then
        return "Nunca expira"
    end

    local days = math.floor(remaining / 86400)
    local hours = math.floor((remaining % 86400) / 3600)
    local minutes = math.floor((remaining % 3600) / 60)

    if days > 0 then
        return hours > 0 and string.format("%d dias e %dh", days, hours) or string.format("%d dias", days)
    elseif hours > 0 then
        return string.format("%dh %dm", hours, minutes)
    end

    return string.format("%dm", minutes)
end

local function updateExpireText()
    local remaining = (_G.LoaderExpireAt or 0) - os.time()
    Window:Update({ ExpireDate = formatRemaining(remaining) })
end

updateExpireText()
task.spawn(function()
    while true do
        task.wait(300)
        updateExpireText()
    end
end)
