FOVCorner.Parent = FOVFrame

-- Para o estilo 'Traçado'
local fovDrawingLines = {}

local function ClearTracedLines()
    for _, line in ipairs(fovDrawingLines) do
        line.Visible = false
        line:Remove()
    end
    fovDrawingLines = {}
end

local function CreateTracedLines(halfFOV, center, color, transparency, thickness)
    local lines = {}
    local offsets = {
        {Vector2.new(-halfFOV, -halfFOV), Vector2.new(-halfFOV/2, -halfFOV)},
        {Vector2.new(-halfFOV, -halfFOV), Vector2.new(-halfFOV, -halfFOV/2)},
        {Vector2.new(halfFOV, -halfFOV), Vector2.new(halfFOV/2, -halfFOV)},
        {Vector2.new(halfFOV, -halfFOV), Vector2.new(halfFOV, -halfFOV/2)},
        {Vector2.new(-halfFOV, halfFOV), Vector2.new(-halfFOV/2, halfFOV)},
        {Vector2.new(-halfFOV, halfFOV), Vector2.new(-halfFOV, halfFOV/2)},
        {Vector2.new(halfFOV, halfFOV), Vector2.new(halfFOV/2, halfFOV)},
        {Vector2.new(halfFOV, halfFOV), Vector2.new(halfFOV, halfFOV/2)}
    }
    for _, offset in ipairs(offsets) do
        local l = Drawing.new("Line")
        l.From = center + offset[1]
        l.To = center + offset[2]
        l.Color = color
        l.Transparency = 1 - transparency
        l.Thickness = thickness
        l.Visible = true
        table.insert(lines, l)
    end
    return lines
end

-- // Funções de Suporte
local function IsVisible(targetPart)
    if not getgenv().Aimbot_WallCheck then return true end
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
    local origin = Camera.CFrame.Position
    local destination = targetPart.Position
    local direction = (destination - origin).Unit * (destination - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
    local result = workspace:Raycast(origin, direction, params)
    return result == nil or (result.Instance and result.Instance:IsDescendantOf(targetPart.Parent))
end

local function GetClosestPlayer()
    -- Verificação de Item Check (Usuário)
    if getgenv().Aimbot_ItemCheck then
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if not tool then return nil end
    end

    local Target = nil
    local MaxDist = getgenv().Aimbot_FOV
    local Center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if getgenv().Aimbot_Whitelist[p.Name] then continue end
            if getgenv().Aimbot_IgnoreFriends and LocalPlayer:IsFriendsWith(p.UserId) then continue end
            if getgenv().Aimbot_TeamCheck and p.Team == LocalPlayer.Team then continue end
            
            local Hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not Hum or Hum.Health <= 0 then continue end
            
            local targetPart = p.Character:FindFirstChild(getgenv().Aimbot_TargetPart)
            if not targetPart then continue end
            if not IsVisible(targetPart) then continue end

            local Pos, OnScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if OnScreen then
                local Dist = (Vector2.new(Pos.X, Pos.Y) - Center).Magnitude
                if Dist < MaxDist then
                    MaxDist = Dist
                    Target = targetPart
                end
            end
        end
    end
    return Target
end

-- // Loop Principal (conectado apenas quando o Aimbot está ativo)
local Hue = 0
local Aimbot_Conn = nil
local function Aimbot_Render(dt)
    local active = getgenv().Aimbot_Ativo and getgenv().Aimbot_FOVStyle ~= "Nenhum"
    FOVFrame.Visible = active
    
    if active then
        local size = getgenv().Aimbot_FOV * 2
        FOVFrame.Size = UDim2.new(0, size, 0, size)
        
        if getgenv().Aimbv_FOVRGB then
            Hue = (Hue + dt * 0.2) % 1
            FOVStroke.Color = Color3.fromHSV(Hue, 0.8, 1)
        else
            FOVStroke.Color = getgenv().Aimbot_FOVColor
        end
        
        local trans = getgenv().Aimbot_FOVTransparency
        if getgenv().Aimbot_FOVStyle == "Animado" then
            trans = trans * (0.5 + 0.5 * math.sin(tick() * 5))
        end
        FOVStroke.Transparency = trans

        if getgenv().Aimbot_FOVStyle == "Círculo" or getgenv().Aimbot_FOVStyle == "Animado" then
            FOVCorner.CornerRadius = UDim.new(1, 0)
            FOVStroke.Enabled = true
            ClearTracedLines()
        elseif getgenv().Aimbot_FOVStyle == "Quadrado" then
            FOVCorner.CornerRadius = UDim.new(0, 0)
            FOVStroke.Enabled = true
            ClearTracedLines()
        elseif getgenv().Aimbot_FOVStyle == "Traçado" then
            FOVStroke.Enabled = false
            if #fovDrawingLines == 0 then
                fovDrawingLines = CreateTracedLines(getgenv().Aimbot_FOV, Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2), FOVStroke.Color, trans, FOVStroke.Thickness)
            else
                -- Atualiza posições e cores das linhas
                local color = FOVStroke.Color
                for _, l in ipairs(fovDrawingLines) do
                    l.Color = color
                    l.Transparency = 1 - trans
                end
            end
        end
    else
        ClearTracedLines()
    end

    if getgenv().Aimbot_Ativo then
        local Target = GetClosestPlayer()
        getgenv().Aimbot_CurrentPart = Target
        if Target then
            local aimPos = Target.Position
            if Target.Parent:FindFirstChild("HumanoidRootPart") then
                aimPos = aimPos + (Target.Parent.HumanoidRootPart.Velocity * 0.05)
            end
            local TargetCF = CFrame.new(Camera.CFrame.Position, aimPos)
            if getgenv().Aimbot_Metodo == "Aimbot Puro" then
                Camera.CFrame = TargetCF
            else
                local alpha = math.clamp(getgenv().Aimbot_Forca / 100, 0.01, 1)
                Camera.CFrame = Camera.CFrame:Lerp(TargetCF, alpha)
            end
        end
    end
end

local function Aimbot_SetActive(state)
    getgenv().Aimbot_Ativo = state
    if state then
        if not Aimbot_Conn then
            Aimbot_Conn = RunService.RenderStepped:Connect(Aimbot_Render)
        end
    else
        if Aimbot_Conn then
            Aimbot_Conn:Disconnect()
            Aimbot_Conn = nil
        end
        FOVFrame.Visible = false
        ClearTracedLines()
    end
end

