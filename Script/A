do -- escopo local (limite de 200 registradores)
local SilentAimTab = CombatContainer:DrawTab({
    Name = "Silent Aim",
    Type = "Double",
    EnableScrolling = true,
});

-- // Configurações Globais
getgenv().SilentAim_Ativo      = false
getgenv().SilentAim_TeamCheck  = false
getgenv().SilentAim_WallCheck  = true
-- Fire Func Check fica DESLIGADO por padrão. O gate por palavra-chave no
-- traceback silencia o redirect em qualquer arma cuja função de tiro não tenha
-- um nome "bonitinho" (o caso da MAIORIA das armas) -> era isso que fazia a
-- maioria das balas não contar dano. A validação de argumentos por tipo já
-- impede corromper chamadas não relacionadas, então o gate é opcional.
getgenv().SilentAim_FireFunc   = false
getgenv().SilentAim_TargetPart = "Nearest" -- "Head", "HumanoidRootPart", "Nearest"
getgenv().SilentAim_FOV        = 150
getgenv().SilentAim_ShowFOV    = true
getgenv().SilentAim_ShowTarget = false
getgenv().SilentAim_HitChance  = 100
getgenv().SilentAim_Prediction = 0
getgenv().SilentAim_NPCs       = true

-- // Métodos ativos (multi-seleção via UI)
-- Liga por padrão todos os métodos baseados em ray: são os "métodos seguros"
-- que o próprio menu documenta e cobrem a maioria dos sistemas de tiro. Os
-- métodos via Camera/Mouse ficam opt-in (podem afetar coisas fora de tiro).
local SA_Methods = {
    Raycast = true,
    FindPartOnRay = true,
    FindPartOnRayWithIgnoreList = true,
    FindPartOnRayWithWhitelist = true,
    ViewportPointToRay = false,
    ScreenPointToRay = false,
    MouseHit = false,
}

-- // API do executor
-- Resolvidos sob demanda (não no load): alguns executores só expõem
-- getnamecallmethod/hookmetamethod depois do inject, e capturar nil no load
-- deixava o silent aim morto (nunca redirecionava nada).
local function SA_GetNamecall()
    return (getnamecallmethod and getnamecallmethod()) or (syn and syn.getnamecallmethod and syn.getnamecallmethod())
end
local function SA_CheckCaller()
    local f = checkcaller or (syn and syn.checkcaller)
    return f and f() or false
end
local function SA_HookMeta(obj, name, fn)
    local h = hookmetamethod or (syn and syn.hookmetamethod)
    if not h then return nil end
    return h(obj, name, fn)
end
local function SA_Closure(fn)
    local nc = newcclosure or (syn and syn.newcclosure)
    return nc and nc(fn) or fn
end

-- // Cache do alvo (recalculado a cada frame enquanto ativo)
local SA_TargetPart, SA_TargetPos = nil, nil
local SA_ChanceOK = true

-- // Partes válidas para a busca "Nearest"
local SA_ValidParts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"}

-- // FOV (Drawing.Circle)
local SA_FOVCircle
pcall(function()
    SA_FOVCircle = Drawing.new("Circle")
    SA_FOVCircle.Thickness, SA_FOVCircle.NumSides = 1.5, 60
    SA_FOVCircle.Radius, SA_FOVCircle.Filled, SA_FOVCircle.Visible, SA_FOVCircle.Transparency = 150, false, false, 0.85
end)

-- // Marcador do alvo (onde o silent aim vai atirar)
local SA_TargetMarker
pcall(function()
    SA_TargetMarker = Drawing.new("Square")
    SA_TargetMarker.Thickness, SA_TargetMarker.Filled, SA_TargetMarker.Visible = 1.5, false, false
    SA_TargetMarker.Size = Vector2.new(16, 16)
end)

local SA_FOVConn = nil
local function SA_FOVRender()
    if SA_FOVCircle then
        if getgenv().SilentAim_Ativo and getgenv().SilentAim_ShowFOV then
            SA_FOVCircle.Visible  = true
            SA_FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            SA_FOVCircle.Radius   = getgenv().SilentAim_FOV
            SA_FOVCircle.Color    = getgenv().Aimbot_FOVColor
        else
            SA_FOVCircle.Visible = false
        end
    end

    if SA_TargetMarker then
        if getgenv().SilentAim_Ativo and getgenv().SilentAim_ShowTarget and SA_TargetPos then
            local pos, onScreen = Camera:WorldToViewportPoint(SA_TargetPos)
            SA_TargetMarker.Position = Vector2.new(pos.X, pos.Y)
            SA_TargetMarker.Visible  = onScreen and pos.Z > 0
            SA_TargetMarker.Color    = getgenv().Aimbot_FOVColor
        else
            SA_TargetMarker.Visible = false
        end
    end
end

-- // Verificação de parede
local function SA_CheckWall(targetPos, otherChar)
    if not getgenv().SilentAim_WallCheck then return true end
    local ok, res = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LocalPlayer.Character, otherChar }
        return workspace:Raycast(Camera.CFrame.Position, targetPos - Camera.CFrame.Position, params)
    end)
    return ok and not res
end

-- // Considera um modelo (player ou NPC) como candidato
local function SA_ConsiderModel(model, center, best)
    if model == LocalPlayer.Character then return best end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return best end

    local part
    if getgenv().SilentAim_TargetPart == "Nearest" then
        local partDist = math.huge
        for _, name in ipairs(SA_ValidParts) do
            local p = model:FindFirstChild(name)
            if p and p:IsA("BasePart") then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Position)
                if onScreen and pos.Z > 0 then
                    local d = (center - Vector2.new(pos.X, pos.Y)).Magnitude
                    if d < partDist then partDist = d; part = p end
                end
            end
        end
    else
        part = model:FindFirstChild(getgenv().SilentAim_TargetPart) or model:FindFirstChild("HumanoidRootPart")
    end
    if not part then return best end

    local ok, pos, onScreen = pcall(function() return Camera:WorldToViewportPoint(part.Position) end)
    if not ok or not onScreen or pos.Z <= 0 then return best end

    local dist = (center - Vector2.new(pos.X, pos.Y)).Magnitude
    if dist > getgenv().SilentAim_FOV or (best and dist >= best.dist) then return best end

    return { model = model, part = part, pos = part.Position, dist = dist }
end

-- // Scan de NPCs (cache de 1s)
local SA_NpcCache = {}
local SA_LastNpcScan = 0
local function SA_ScanNPCs()
    local now = tick()
    if now - SA_LastNpcScan < 1 then return SA_NpcCache end
    SA_LastNpcScan = now
    SA_NpcCache = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v ~= LocalPlayer.Character then
            local hum = v:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(v) then
                table.insert(SA_NpcCache, v)
            end
        end
    end
    return SA_NpcCache
end

-- // Atualiza o alvo (respeita a whitelist do Aimbot)
local function SA_UpdateTarget()
    if not getgenv().SilentAim_Ativo or not LocalPlayer.Character then
        SA_TargetPart, SA_TargetPos = nil, nil
        getgenv().SilentAim_CurrentPart = nil
        return
    end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local best = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not getgenv().Aimbot_Whitelist[plr.Name] then
            if not (getgenv().SilentAim_TeamCheck and plr.Team == LocalPlayer.Team) then
                local char = plr.Character
                if char then best = SA_ConsiderModel(char, center, best) end
            end
        end
    end

    if getgenv().SilentAim_NPCs then
        for _, model in ipairs(SA_ScanNPCs()) do
            best = SA_ConsiderModel(model, center, best)
        end
    end

    if best and not SA_CheckWall(best.pos, best.model) then best = nil end

    if best then
        SA_TargetPart = best.part
        getgenv().SilentAim_CurrentPart = best.part
        local p = best.pos
        if getgenv().SilentAim_Prediction > 0 and best.part:IsA("BasePart") then
            p = p + (best.part.AssemblyLinearVelocity or Vector3.new(0, 0, 0)) * getgenv().SilentAim_Prediction
        end
        SA_TargetPos = p
    else
        SA_TargetPart, SA_TargetPos = nil, nil
        getgenv().SilentAim_CurrentPart = nil
    end
end

-- // Helpers
local function SA_RollChance()
    local chance = getgenv().SilentAim_HitChance
    if chance >= 100 then return true end
    return math.random(1, 100) <= chance
end

-- // Alvo por frame: mantém o alvo fresco (evita mira em posição atrasada)
local SA_TargetConn = nil
local function SA_TargetLoop()
    pcall(SA_UpdateTarget)
    SA_ChanceOK = SA_RollChance()
end

local SA_FireKeywords = {
    "bullet", "gun", "fire", "shoot", "weapon", "projectile",
    "shot", "raycast", "trace", "attack", "aim", "combat", "blaster"
}
local function SA_IsFireFunc()
    if not getgenv().SilentAim_FireFunc then return true end
    -- Sem debug.traceback não dá pra inspecionar a pilha: não bloquear o tiro.
    if not (debug and debug.traceback) then return true end
    local ok, tb = pcall(function() return debug.traceback():lower() end)
    if not ok or type(tb) ~= "string" then return true end
    for _, kw in ipairs(SA_FireKeywords) do
        if tb:find(kw, 1, true) then return true end
    end
    return false
end

-- // Checagem barata (chamada a cada namecall/index). O teste caro de
-- "fire func" (debug.traceback) NÃO fica aqui: só roda depois de a chamada
-- casar com um método/alvo, senão cada :Metodo() do jogo pagaria o traceback.
local function SA_CanRun()
    if not getgenv().SilentAim_Ativo or SA_TargetPos == nil then return false end
    if SA_CheckCaller and SA_CheckCaller() then return false end
    return SA_ChanceOK
end

-- // Validação de argumentos (evita corromper chamadas não relacionadas)
local SA_ExpectedArgs = {
    Raycast = { ArgCountRequired = 3, Args = {"Instance", "Vector3", "Vector3", "RaycastParams"} },
    FindPartOnRay = { ArgCountRequired = 2, Args = {"Instance", "Ray", "Instance", "boolean", "boolean"} },
    FindPartOnRayWithIgnoreList = { ArgCountRequired = 3, Args = {"Instance", "Ray", "table", "boolean", "boolean"} },
    FindPartOnRayWithWhitelist = { ArgCountRequired = 3, Args = {"Instance", "Ray", "table", "boolean"} },
}
local function SA_ValidateArgs(args, method)
    local spec = SA_ExpectedArgs[method]
    if not spec then return true end
    if #args < spec.ArgCountRequired then return false end
    local matches = 0
    for i, arg in ipairs(args) do
        if spec.Args[i] and typeof(arg) == spec.Args[i] then matches = matches + 1 end
    end
    return matches >= spec.ArgCountRequired
end

-- // Direção (mira no alvo, a partir da origem do tiro)
local function SA_Direction(origin, dest)
    return (dest - origin).Unit * 1000
end

-- // Hooks (instalados sob demanda: só com Silent Aim ativo e método que exige)
-- Ficam fora do load para não deixar "__index"/"__namecall" hookados o tempo todo
-- (era isso que detectores de "IndexInstance" flagavam).
local SA_OldNamecall, SA_OldIndex
local SA_NamecallHooked, SA_IndexHooked = false, false

local function SA_NamecallHook(...)
    local method = SA_GetNamecall and SA_GetNamecall()
    if not SA_CanRun() then return SA_OldNamecall(...) end

    local args = {...}
    local self = args[1]
    if self ~= workspace and self ~= Camera then return SA_OldNamecall(...) end

    -- Raycast: args[2]=origem (Vector3), args[3]=direção
    if self == workspace and method == "Raycast" and SA_Methods.Raycast then
        if SA_ValidateArgs(args, "Raycast") and SA_IsFireFunc() then
            local origin = args[2]
            if typeof(origin) == "Vector3" then
                args[3] = SA_Direction(origin, SA_TargetPos)
                return SA_OldNamecall(unpack(args))
            end
        end
    end

    -- FindPartOnRay*: args[2]=Ray
    if self == workspace then
        local ray = args[2]
        local name = method
        if name == "findPartOnRay" then name = "FindPartOnRay" end
        if typeof(ray) == "Ray" and SA_Methods[name] then
            if SA_ValidateArgs(args, name) and SA_IsFireFunc() then
                args[2] = Ray.new(ray.Origin, SA_Direction(ray.Origin, SA_TargetPos))
                return SA_OldNamecall(unpack(args))
            end
        end
    end

    -- Camera: ViewportPointToRay / ScreenPointToRay devolvem um Ray
    if self == Camera then
        if method == "ViewportPointToRay" and SA_Methods.ViewportPointToRay then
            if SA_IsFireFunc() then
                local origin = Camera.CFrame.Position
                return Ray.new(origin, SA_Direction(origin, SA_TargetPos))
            end
        end
        if method == "ScreenPointToRay" and SA_Methods.ScreenPointToRay then
            if SA_IsFireFunc() then
                local origin = Camera.CFrame.Position
                return Ray.new(origin, SA_Direction(origin, SA_TargetPos))
            end
        end
    end

    return SA_OldNamecall(...)
end

local function SA_IndexHook(t, k)
    if SA_CanRun() and typeof(t) == "Instance" and t:IsA("Mouse") then
        if k == "Hit" and SA_Methods.MouseHit and SA_IsFireFunc() then
            return CFrame.new(SA_TargetPos)
        elseif k == "Target" and SA_Methods.MouseHit and SA_IsFireFunc() then
            return SA_TargetPart
        elseif (k == "X" or k == "Y") and SA_Methods.MouseHit and SA_IsFireFunc() then
            local p = Camera:WorldToScreenPoint(SA_TargetPos)
            return p[k]
        elseif k == "UnitRay" and SA_Methods.MouseHit and SA_IsFireFunc() then
            local origin = SA_OldIndex(t, "UnitRay").Origin
            return Ray.new(origin, SA_Direction(origin, SA_TargetPos))
        end
    end
    return SA_OldIndex(t, k)
end

local function SA_NeedsNamecall()
    return SA_Methods.Raycast or SA_Methods.FindPartOnRay or SA_Methods.FindPartOnRayWithIgnoreList
        or SA_Methods.FindPartOnRayWithWhitelist or SA_Methods.ViewportPointToRay or SA_Methods.ScreenPointToRay
end

-- Instala/remove os hooks conforme o estado atual (ativo + método). Fica sem
-- hook nenhum quando o Silent Aim está desligado ou o método não precisa.
local function SA_UpdateHooks()
    local wantNamecall = getgenv().SilentAim_Ativo and SA_NeedsNamecall()
    if wantNamecall and not SA_NamecallHooked then
        SA_OldNamecall = SA_HookMeta(game, "__namecall", SA_Closure(SA_NamecallHook))
        SA_NamecallHooked = SA_OldNamecall ~= nil
    elseif not wantNamecall and SA_NamecallHooked then
        SA_HookMeta(game, "__namecall", SA_OldNamecall)
        SA_OldNamecall = nil
        SA_NamecallHooked = false
    end

    local wantIndex = getgenv().SilentAim_Ativo and SA_Methods.MouseHit
    if wantIndex and not SA_IndexHooked then
        SA_OldIndex = SA_HookMeta(game, "__index", SA_Closure(SA_IndexHook))
        SA_IndexHooked = SA_OldIndex ~= nil
    elseif not wantIndex and SA_IndexHooked then
        SA_HookMeta(game, "__index", SA_OldIndex)
        SA_OldIndex = nil
        SA_IndexHooked = false
    end
end

-- // UI
local SAConfig = SilentAimTab:DrawSection({ Name = "Configurações", Position = 'left' });
local SAVisual = SilentAimTab:DrawSection({ Name = "Visual", Position = 'right' });

local function SA_SetActive(state)
    getgenv().SilentAim_Ativo = state
    if state then
        if not SA_FOVConn then
            SA_FOVConn = RunService.RenderStepped:Connect(SA_FOVRender)
        end
        if not SA_TargetConn then
            SA_TargetConn = RunService.RenderStepped:Connect(SA_TargetLoop)
        end
    else
        if SA_FOVConn then
            SA_FOVConn:Disconnect()
            SA_FOVConn = nil
        end
        if SA_TargetConn then
            SA_TargetConn:Disconnect()
            SA_TargetConn = nil
        end
        if SA_FOVCircle then SA_FOVCircle.Visible = false end
        SA_TargetPart, SA_TargetPos = nil, nil
    end
    SA_UpdateHooks()
end
SAConfig:AddToggle({
    Flag = "SAConfig_AtivarSilentAim", Name = "Ativar Silent Aim", Default = false, Callback = SA_SetActive });
SAConfig:AddToggle({
    Flag = "SAConfig_TeamCheck", Name = "Team Check", Default = false, Callback = function(v) getgenv().SilentAim_TeamCheck = v end });
SAConfig:AddToggle({
    Flag = "SAConfig_WallCheck", Name = "Wall Check", Default = true, Callback = function(v) getgenv().SilentAim_WallCheck = v end });
SAConfig:AddToggle({
    Flag = "SAConfig_FireFuncCheck", Name = "Fire Func Check", Default = false, Callback = function(v) getgenv().SilentAim_FireFunc = v end });
SAConfig:AddToggle({
    Flag = "SAConfig_IncluirNPCs", Name = "Incluir NPCs", Default = true, Callback = function(v) getgenv().SilentAim_NPCs = v end });
SAConfig:AddDropdown({
    Flag = "SAConfig_PartedoAlvo",
    Name = "Parte do Alvo",
    Default = "Nearest",
    Values = {"Nearest", "Head", "HumanoidRootPart", "UpperTorso", "LowerTorso"},
    Callback = function(v) getgenv().SilentAim_TargetPart = v end
});
SAConfig:AddSlider({
    Flag = "SAConfig_FOVRadius", Name = "FOV Radius", Min = 20, Max = 500, Default = 150, Callback = function(v) getgenv().SilentAim_FOV = v end });
SAConfig:AddSlider({
    Flag = "SAConfig_HitChance", Name = "Hit Chance", Min = 1, Max = 100, Default = 100, Callback = function(v) getgenv().SilentAim_HitChance = v end });
SAConfig:AddSlider({
    Flag = "SAConfig_Predio", Name = "Predição", Min = 0, Max = 0.5, Default = 0, Round = 2, Callback = function(v) getgenv().SilentAim_Prediction = v end });

SAVisual:AddToggle({
    Flag = "SAVisual_MostrarFOV", Name = "Mostrar FOV", Default = true, Callback = function(v) getgenv().SilentAim_ShowFOV = v end });
SAVisual:AddToggle({
    Flag = "SAVisual_MostrarAlvo", Name = "Mostrar Alvo", Default = false, Callback = function(v) getgenv().SilentAim_ShowTarget = v end });
SAVisual:AddDropdown({
    Flag = "SAVisual_Mtodos",
    Name = "Métodos",
    Default = {"Raycast"},
    Values = {"Raycast", "FindPartOnRay", "FindPartOnRayWithIgnoreList", "FindPartOnRayWithWhitelist", "ViewportPointToRay", "ScreenPointToRay", "MouseHit"},
    Multi = true,
    Callback = function(selected)
        for k in pairs(SA_Methods) do SA_Methods[k] = false end
        if type(selected) == "table" then
            for k, on in pairs(selected) do
                if on then SA_Methods[k] = true end
            end
        end
        SA_UpdateHooks()
    end
});
SAVisual:AddParagraph({ Title = "Métodos seguros:", Content = "Raycast, FindPartOnRay*" });
SAVisual:AddParagraph({ Title = "Métodos arriscados:", Content = "ViewportPointToRay, ScreenPointToRay, Mouse.Hit" });
end




do -- escopo local (limite de 200 registradores)
local HitboxTab = CombatContainer:DrawTab({
	Name = " Hitbox  ",
	Type = "Double"
});
local hitboxSize = 10
local hitboxTransparency = 0.9
local hitboxEnabled = false
local hitboxIncreaseButton, hitboxDecreaseButton
local function isEnemy(player)
    if not player or not localPlayer then return false end
    local playerTeam = player.Team
    local myTeam = localPlayer.Team
    -- Se ambos têm time, compara; se um deles não tem, considera inimigo
    if playerTeam and myTeam then
        return playerTeam ~= myTeam
    end
    return true -- sem time = inimigo
end
-- Helper functions
local function applyHitbox(character)
if not character then return end

-- Skip if this is the local player's character  
local player = Players:GetPlayerFromCharacter(character)  
if player and player == localPlayer then  
    return  
end  
  
-- Only apply hitbox if character is alive  
local humanoid = character:FindFirstChildOfClass("Humanoid")  
if humanoid and humanoid.Health <= 0 then  
    return  
end  
  
-- Handle R15 characters differently  
local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15  
  
-- HumanoidRootPart modifications  
local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")  
if rootPart then  
    if not rootPart:FindFirstChild("OriginalSize") then  
        local originalSize = Instance.new("Vector3Value")  
        originalSize.Name = "OriginalSize"  
        originalSize.Value = rootPart.Size  
        originalSize.Parent = rootPart  
    end  
      
    rootPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)  
    rootPart.Transparency = hitboxTransparency  
    rootPart.BrickColor = BrickColor.new("Dark red")  
    rootPart.Material = Enum.Material.ForceField  
    rootPart.CanCollide = false  
      
    -- For R15, we need to adjust the other parts too  
    if isR15 then  
        local lowerTorso = character:FindFirstChild("LowerTorso")  
        if lowerTorso then  
            if not lowerTorso:FindFirstChild("OriginalSize") then  
                local originalSize = Instance.new("Vector3Value")  
                originalSize.Name = "OriginalSize"  
                originalSize.Value = lowerTorso.Size  
                originalSize.Parent = lowerTorso  
            end  
            lowerTorso.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)  
            lowerTorso.Transparency = hitboxTransparency  
            lowerTorso.BrickColor = BrickColor.new("Dark red")  
            lowerTorso.Material = Enum.Material.ForceField  
            lowerTorso.CanCollide = false  
        end  
    end  
end  
  
-- Head modifications  
local head = character:FindFirstChild("Head")  
if head then  
    if not head:FindFirstChild("OriginalSize") then  
        local originalSize = Instance.new("Vector3Value")  
        originalSize.Name = "OriginalSize"  
        originalSize.Value = head.Size  
        originalSize.Parent = head  
    end  
      
    head.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)  
    head.Transparency = hitboxTransparency  
    head.BrickColor = BrickColor.new("Bright red")  
    head.Material = Enum.Material.ForceField  
    head.CanCollide = false  
    head.Massless = true  
end  
  
-- For R15, adjust other important parts  
if isR15 then  
    local partsToAdjust = {"UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}  
    for _, partName in ipairs(partsToAdjust) do  
        local part = character:FindFirstChild(partName)  
        if part then  
            if not part:FindFirstChild("OriginalSize") then  
                local originalSize = Instance.new("Vector3Value")  
                originalSize.Name = "OriginalSize"  
                originalSize.Value = part.Size  
                originalSize.Parent = part  
            end  
              
            part.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)  
            part.Transparency = hitboxTransparency  
            part.BrickColor = BrickColor.new("Dark red")  
            part.Material = Enum.Material.ForceField  
            part.CanCollide = false  
        end  
    end  
end

end

local function resetHitbox(character)
if not character then return end

-- Skip if this is the local player's character  
local player = Players:GetPlayerFromCharacter(character)  
if player and player == localPlayer then  
    return  
end  
  
-- Reset HumanoidRootPart  
local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")  
if rootPart and rootPart:FindFirstChild("OriginalSize") then  
    rootPart.Size = rootPart.OriginalSize.Value  
    rootPart.Transparency = 1  
    rootPart.BrickColor = BrickColor.new("Medium stone grey")  
    rootPart.Material = Enum.Material.Plastic  
    rootPart.CanCollide = true  
end  
  
-- Reset Head  
local head = character:FindFirstChild("Head")  
if head and head:FindFirstChild("OriginalSize") then  
    head.Size = head.OriginalSize.Value  
    head.Transparency = 1  
    head.BrickColor = BrickColor.new("Medium stone grey")  
    head.Material = Enum.Material.Plastic  
    head.CanCollide = true  
    head.Massless = false  
end  
  
-- Reset R15 parts  
local humanoid = character:FindFirstChildOfClass("Humanoid")  
local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15  
  
if isR15 then  
    local partsToReset = {"LowerTorso", "UpperTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}  
    for _, partName in ipairs(partsToReset) do  
        local part = character:FindFirstChild(partName)  
        if part and part:FindFirstChild("OriginalSize") then  
            part.Size = part.OriginalSize.Value  
            part.Transparency = 1  
            part.BrickColor = BrickColor.new("Medium stone grey")  
            part.Material = Enum.Material.Plastic  
            part.CanCollide = true  
        end  
    end  
end

end

local function applyHitboxesToAllPlayers()
for _, player in ipairs(Players:GetPlayers()) do
if isEnemy(player) and player.Character then
applyHitbox(player.Character)
end
end
end

local function resetHitboxesOnAllPlayers()
for _, player in ipairs(Players:GetPlayers()) do
if player.Character then
resetHitbox(player.Character)
end
end
end

-- Hitbox toggle system
local hitboxCoroutine
local function toggleHitboxes(enabled)
hitboxEnabled = enabled


if enabled then  
    applyHitboxesToAllPlayers()  
      
    if not hitboxCoroutine then  
        hitboxCoroutine = coroutine.create(function()  
            while hitboxEnabled and task.wait(0.5) do  
                applyHitboxesToAllPlayers()  
            end  
        end)  
        coroutine.resume(hitboxCoroutine)  
    end  
else  
    if hitboxCoroutine then  
        coroutine.close(hitboxCoroutine)  
        hitboxCoroutine = nil  
    end  
    resetHitboxesOnAllPlayers()  
end  
  
-- Update button visibility  
if hitboxIncreaseButton and hitboxDecreaseButton then  
    hitboxIncreaseButton.Visible = enabled  
    hitboxDecreaseButton.Visible = enabled  
end

end

-- ===========================
-- ABA HITBOX (conteúdo)
-- Cole isto APÓS a linha:
--   local HitboxTab = CombatContainer:DrawTab({ ... })
-- ===========================

