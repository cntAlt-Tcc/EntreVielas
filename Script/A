    Flag = "SAVisual_MostrarFOV", Name = "Mostrar FOV", Default = true, Callback = function(v) getgenv().SilentAim_ShowFOV = v end });
SAVisual:AddToggle({
    Flag = "SAVisual_SegueMouse", Name = "Seguir Mouse (FOV)", Default = false, Callback = function(v) getgenv().SilentAim_FOVFollowMouse = v end });
SAVisual:AddToggle({
    Flag = "SAVisual_MostrarAlvo", Name = "Mostrar Alvo", Default = false, Callback = function(v) getgenv().SilentAim_ShowTarget = v end });
SAVisual:AddDropdown({
    Flag = "SAVisual_Mtodos",
    Name = "Métodos",
    Default = {"Raycast"},
    Values = {"Raycast", "FindPartOnRay", "FindPartOnRayWithIgnoreList", "FindPartOnRayWithWhitelist", "ViewportPointToRay", "ScreenPointToRay", "MouseHit"},
    Multi = true,
    Callback = function(selected)
        for k in pairs(SA_Methods) do SA_Methods[k] = false end
        if type(selected) == "table" then
            -- The dropdown hands back the array form ({"Raycast"}) as its Default
            -- and when a config restores it, and the map form ({Raycast = true})
            -- while the user is picking. Handle both, otherwise a load wiped the
            -- active methods and left the aim hooking nothing.
            for k, on in pairs(selected) do
                if on == true then
                    SA_Methods[k] = true
                elseif type(k) == "number" and type(on) == "string" then
                    SA_Methods[on] = true
                end
            end
        elseif type(selected) == "string" then
            SA_Methods[selected] = true
        end
        SA_UpdateHooks()
    end
});
SAVisual:AddParagraph({ Title = "Métodos seguros:", Content = "Raycast, FindPartOnRay*" });
SAVisual:AddParagraph({ Title = "Métodos arriscados:", Content = "ViewportPointToRay, ScreenPointToRay, Mouse.Hit" });
SAConfig:AddParagraph({ Title = "Ghost Mode:", Content = "Instala o hook na metatable (sem hookmetamethod). Requer getrawmetatable + setreadonly no executor; sem eles cai no método normal." });

-- After a config load, re-sync the hooks once with the final values (the load
-- itself skipped every SA_UpdateHooks call to avoid the detection churn).
FiveSync:AddOnConfigLoad(function()
    SA_SetActive(getgenv().SilentAim_Ativo)
end)
end




do -- escopo local (limite de 200 registradores)
local HitboxTab = CombatContainer:DrawTab({
	Name = " Hitbox  ",
	Type = "Double"
});
local hitboxSize = 10
local hitboxTransparency = 0.9
local hitboxEnabled = false
local hitboxIncreaseButton, hitboxDecreaseButton
local function isEnemy(player)
    if not player or not localPlayer then return false end
    local playerTeam = player.Team
    local myTeam = localPlayer.Team
    -- Se ambos têm time, compara; se um deles não tem, considera inimigo
    if playerTeam and myTeam then
        return playerTeam ~= myTeam
    end
    return true -- sem time = inimigo
end
-- Helper functions
-- Snapshot das propriedades originais de cada parte que o hitbox altera.
-- Guardar so o Size (num Vector3Value filho, como antes) nao bastava: ao desligar,
-- o reset sobrescrevia Transparency/BrickColor/Material/CanCollide com valores
-- fixos, corrompendo o visual e a fisica de qualquer personagem ja alterado.
local HitboxSnapshots = setmetatable({}, { __mode = "k" })

local function HitboxSnapshot(part)
    local snap = HitboxSnapshots[part]
    if not snap then
        snap = {
            Size = part.Size,
            Transparency = part.Transparency,
            BrickColor = part.BrickColor,
            Material = part.Material,
            CanCollide = part.CanCollide,
            Massless = part.Massless,
        }
        HitboxSnapshots[part] = snap
    end
    return snap
end

local function HitboxRestorePart(part)
    local snap = HitboxSnapshots[part]
    if not snap then return end

    pcall(function()
        part.Size = snap.Size
        part.Transparency = snap.Transparency
        part.BrickColor = snap.BrickColor
        part.Material = snap.Material
        part.CanCollide = snap.CanCollide
        part.Massless = snap.Massless
    end)

    HitboxSnapshots[part] = nil
end

-- So escreve na parte quando o valor muda: os sliders reaplicam em todo mundo a
-- cada arrasto, e escrever a mesma propriedade re-replica para o servidor.
local function HitboxExpand(part, size, transparency, color)
    if not part then return end

    HitboxSnapshot(part)

    local target = Vector3.new(size, size, size)
    if part.Size ~= target then part.Size = target end
    if part.Transparency ~= transparency then part.Transparency = transparency end

    local brick = BrickColor.new(color)
    if part.BrickColor ~= brick then part.BrickColor = brick end
    if part.Material ~= Enum.Material.ForceField then part.Material = Enum.Material.ForceField end
    if part.CanCollide then part.CanCollide = false end
end

local function applyHitbox(character)
    if not character then return end

    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health <= 0 then
        return
    end

    local isR15 = humanoid and humanoid.RigType == Enum.HumanoidRigType.R15

    local rootPart = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso")
    HitboxExpand(rootPart, hitboxSize, hitboxTransparency, "Dark red")

    if isR15 then
        local lowerTorso = character:FindFirstChild("LowerTorso")
        HitboxExpand(lowerTorso, hitboxSize, hitboxTransparency, "Dark red")
    end

    local head = character:FindFirstChild("Head")
    if head then
        HitboxExpand(head, hitboxSize, hitboxTransparency, "Bright red")
        if not head.Massless then head.Massless = true end
    end

    if isR15 then
        local partsToAdjust = {"UpperTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg"}
        for _, partName in ipairs(partsToAdjust) do
            HitboxExpand(character:FindFirstChild(partName), hitboxSize, hitboxTransparency, "Dark red")
        end
    end
end

local function resetHitbox(character)
    if not character then return end

    local player = Players:GetPlayerFromCharacter(character)
    if player and player == localPlayer then
        return
    end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and HitboxSnapshots[part] then
            HitboxRestorePart(part)
        end
    end
end

local function applyHitboxesToAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) and player.Character then
            applyHitbox(player.Character)
        end
    end
end

local function resetHitboxesOnAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            resetHitbox(player.Character)
        end
    end
end

-- Aplicacao dirigida por evento: um personagem so precisa do hitbox quando
-- entra na cena. O coroutine de 0.5s reaplicava em todos os jogadores para
-- sempre, mesmo sem nada mudar.
local hitboxPlayerConns = {}
local hitboxGlobalConns = {}

local function HitboxStopWatching()
    for _, conn in pairs(hitboxPlayerConns) do
        pcall(function() conn:Disconnect() end)
    end
    for _, conn in ipairs(hitboxGlobalConns) do
        pcall(function() conn:Disconnect() end)
    end
    hitboxPlayerConns = {}
    hitboxGlobalConns = {}
end

local function HitboxWatchPlayer(player)
    if hitboxPlayerConns[player] then return end

    hitboxPlayerConns[player] = player.CharacterAdded:Connect(function(char)
        if not hitboxEnabled then return end
        task.defer(function()
            if hitboxEnabled then applyHitbox(char) end
        end)
    end)
end

local function HitboxStartWatching()
    HitboxStopWatching()

    for _, player in ipairs(Players:GetPlayers()) do
        HitboxWatchPlayer(player)
    end

    table.insert(hitboxGlobalConns, Players.PlayerAdded:Connect(function(player)
        HitboxWatchPlayer(player)
    end))

    -- Sem isso as conexoes de quem sai ficam na tabela ate o fim da sessao.
    table.insert(hitboxGlobalConns, Players.PlayerRemoving:Connect(function(player)
        local conn = hitboxPlayerConns[player]
        if conn then
            pcall(function() conn:Disconnect() end)
            hitboxPlayerConns[player] = nil
        end
    end))
end

-- Hitbox toggle system
local function toggleHitboxes(enabled)
    hitboxEnabled = enabled

    if enabled then
        applyHitboxesToAllPlayers()
        HitboxStartWatching()
    else
        HitboxStopWatching()
        resetHitboxesOnAllPlayers()
    end

    if hitboxIncreaseButton and hitboxDecreaseButton then
        hitboxIncreaseButton.Visible = enabled
        hitboxDecreaseButton.Visible = enabled
    end
end

