-- Seção Tracers
local SecTracer = Tab:DrawSection({ Name = "Tracers", Position = 'left' });
SecTracer:AddToggle({ Name = "Ativar Tracers", Callback = function(v) Config.Tracer.Enabled = v end }).Link:AddColorPicker({ Default = Config.Tracer.Color, Callback = function(v) Config.Tracer.Color = v end });
SecTracer:AddDropdown({ Name = "Origem", Default = "Bottom", Values = {"Top", "Bottom", "Mouse"}, Callback = function(v) Config.Tracer.Origin = v end });
SecTracer:AddSlider({ Name = "Espessura", Min = 1, Max = 10, Default = 1, Callback = function(v) Config.Tracer.Thickness = v end });
SecTracer:AddSlider({ Name = "Transparência", Min = 0, Max = 1, Default = 1, Round = 2, Callback = function(v) Config.Tracer.Transparency = v end });

-- Seção Info
local SecInfo = Tab:DrawSection({ Name = "Informações & Vida", Position = 'right' });
SecInfo:AddToggle({ Name = "Mostrar Vida", Callback = function(v) Config.Life.Enabled = v end });
SecInfo:AddDropdown({ Name = "Estilo Vida", Default = "Bar", Values = {"Bar", "Text"}, Callback = function(v) Config.Life.Type = v end });
SecInfo:AddToggle({ Name = "Nome", Callback = function(v) Config.Info.Name = v end });
